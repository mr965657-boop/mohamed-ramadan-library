# Supabase Public Configuration (Client & Server)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Secret Admin Key (Server Only - Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Site URL for SEO, Canonical URLs, and Social Sharing
PUBLIC_SITE_URL=https://mohamed-ramadan-library.example.com

# Email Service (e.g. Resend / SMTP for contact form & newsletters)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here
MAIL_FROM="مكتبة محمد رمضان <no-reply@mohamed-ramadan.com>"

# Analytics & SEO Verification (Optional)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=your_google_verification_token
