---
import { getItemBySlug } from '../../lib/db';

const { slug } = Astro.params;
const book = await getItemBySlug(slug as string, 'ar');

if (!book || book.type !== 'book' || !book.file_url) {
  return Astro.redirect('/books');
}
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>قراءة: {book.title} | مكتبة محمد رمضان</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #2D3748;
        font-family: system-ui, -apple-system, sans-serif;
        overflow: hidden;
      }
      #viewer-container {
        height: calc(100vh - 60px);
        overflow: auto;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 20px 10px;
        box-sizing: border-box;
      }
      #pdf-canvas {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        background: white;
        border-radius: 4px;
        max-width: 100%;
      }
      .flip-mode {
        perspective: 1500px;
      }
      .flip-anim {
        transition: transform 0.4s ease-in-out;
      }
    </style>
  </head>
  <body class="flex flex-col h-screen select-none">
    
    <!-- شريط أدوات القارئ العلوي -->
    <header class="h-[60px] bg-[#143D33] text-white flex items-center justify-between px-4 sm:px-6 z-30 shrink-0 border-b border-[#B8924A]/40 shadow-md">
      
      <!-- اسم الكتاب والعودة -->
      <div class="flex items-center gap-3">
        <a
          href={`/books/${book.slug}`}
          class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors text-white"
          title="العودة لصفحة الكتاب"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        </a>
        <div class="max-w-xs sm:max-w-md truncate">
          <h1 class="font-bold text-xs sm:text-sm text-white truncate">{book.title}</h1>
          <span class="text-[10px] text-[#B8924A]">المؤلف: {book.author}</span>
        </div>
      </div>

      <!-- أدوات التنقل بين الصفحات -->
      <div class="flex items-center gap-2 text-xs">
        <button
          id="prev-page"
          class="px-2.5 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
          title="الصفحة السابقة"
        >
          السابق
        </button>

        <div class="flex items-center gap-1 font-sans">
          <input
            type="number"
            id="page-num"
            value="1"
            min="1"
            class="w-12 text-center py-1 bg-white/10 border border-white/20 rounded text-white text-xs font-bold"
          />
          <span>/</span>
          <span id="page-count">--</span>
        </div>

        <button
          id="next-page"
          class="px-2.5 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
          title="الصفحة التالية"
        >
          التالي
        </button>
      </div>

      <!-- أدوات التكبير والتصغير ونمط Flipbook والتنزيل -->
      <div class="flex items-center gap-2">
        <div class="hidden sm:flex items-center gap-1 bg-white/10 p-1 rounded-lg">
          <button id="zoom-out" class="px-2 py-1 hover:bg-white/10 rounded font-bold" title="تصغير">-</button>
          <span id="zoom-text" class="text-[11px] font-sans px-1">100%</span>
          <button id="zoom-in" class="px-2 py-1 hover:bg-white/10 rounded font-bold" title="تكبير">+</button>
        </div>

        <!-- تبديل وضع القراءة: عادي / Flipbook -->
        <button
          id="toggle-flip"
          class="px-2.5 py-1.5 text-xs rounded bg-[#B8924A] text-[#143D33] font-bold hover:bg-[#D4B06A] transition-colors"
          title="تقليب الصفحات / القارئ الكلاسيكي"
        >
          <span id="flip-label">وضع التقليب</span>
        </button>

        {book.allow_download && (
          <a
            href={book.file_url}
            download
            class="hidden md:inline-flex p-2 rounded bg-white/10 hover:bg-white/20 text-white"
            title="تنزيل نسخة PDF"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </a>
        )}
      </div>

    </header>

    <!-- منطقة عرض صفحات الكتاب -->
    <div id="viewer-container" class="relative">
      <div id="loading-indicator" class="text-white text-sm mt-20 flex flex-col items-center gap-3">
        <div class="w-8 h-8 border-4 border-[#B8924A] border-t-transparent rounded-full animate-spin"></div>
        <span>جارٍ تحميل صفحات الكتاب بدقة عالية...</span>
      </div>
      <canvas id="pdf-canvas" class="hidden"></canvas>
    </div>

    <!-- إشعار استكمال القراءة الذاتي -->
    <div
      id="resume-toast"
      class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#143D33] text-white border border-[#B8924A] px-5 py-3 rounded-xl shadow-2xl z-50 text-xs flex items-center gap-4"
    >
      <span>تم استئناف القراءة تلقائياً من الصفحة التي توقفت عندها.</span>
      <button id="close-toast" class="text-[#B8924A] font-bold hover:underline">حسناً</button>
    </div>

    <script is:inline define:vars={{ fileUrl: book.file_url, bookSlug: book.slug }}>
      // إعداد مسار worker الخاص بـ PDF.js
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

      let pdfDoc = null;
      let pageNum = 1;
      let pageRendering = false;
      let pageNumPending = null;
      let scale = 1.25;
      let isFlipMode = false;

      const canvas = document.getElementById('pdf-canvas');
      const ctx = canvas.getContext('2d');
      const loader = document.getElementById('loading-indicator');
      const pageNumInput = document.getElementById('page-num');
      const pageCountSpan = document.getElementById('page-count');
      const zoomText = document.getElementById('zoom-text');
      const prevBtn = document.getElementById('prev-page');
      const nextBtn = document.getElementById('next-page');
      const toggleFlipBtn = document.getElementById('toggle-flip');
      const flipLabel = document.getElementById('flip-label');
      const resumeToast = document.getElementById('resume-toast');

      // استرجاع آخر موضع قراءة محفوظ
      const savedPage = localStorage.getItem(`read_pos_${bookSlug}`);
      if (savedPage) {
        const parsed = parseInt(savedPage);
        if (!isNaN(parsed) && parsed > 1) {
          pageNum = parsed;
          if (resumeToast) resumeToast.classList.remove('hidden');
        }
      }

      function renderPage(num) {
        pageRendering = true;
        pdfDoc.getPage(num).then(function(page) {
          const viewport = page.getViewport({ scale: scale });
          canvas.height = viewport.height;
          canvas.width = viewport.width;

          const renderContext = {
            canvasContext: ctx,
            viewport: viewport
          };
          const renderTask = page.render(renderContext);

          renderTask.promise.then(function() {
            pageRendering = false;
            loader.classList.add('hidden');
            canvas.classList.remove('hidden');

            // حفظ تقدم القراءة تلقائياً
            localStorage.setItem(`read_pos_${bookSlug}`, num.toString());

            if (pageNumPending !== null) {
              renderPage(pageNumPending);
              pageNumPending = null;
            }
          });
        });

        pageNumInput.value = num;
        prevBtn.disabled = (num <= 1);
        nextBtn.disabled = (num >= pdfDoc.numPages);
      }

      function queueRenderPage(num) {
        if (pageRendering) {
          pageNumPending = num;
        } else {
          if (isFlipMode) {
            canvas.classList.add('flip-anim');
            canvas.style.transform = 'rotateY(10deg)';
            setTimeout(() => {
              canvas.style.transform = 'rotateY(0deg)';
              renderPage(num);
            }, 150);
          } else {
            renderPage(num);
          }
        }
      }

      function onPrevPage() {
        if (pageNum <= 1) return;
        pageNum--;
        queueRenderPage(pageNum);
      }

      function onNextPage() {
        if (pageNum >= pdfDoc.numPages) return;
        pageNum++;
        queueRenderPage(pageNum);
      }

      prevBtn.addEventListener('click', onPrevPage);
      nextBtn.addEventListener('click', onNextPage);

      pageNumInput.addEventListener('change', function() {
        let desired = parseInt(this.value);
        if (desired >= 1 && desired <= pdfDoc.numPages) {
          pageNum = desired;
          queueRenderPage(pageNum);
        } else {
          this.value = pageNum;
        }
      });

      document.getElementById('zoom-in').addEventListener('click', function() {
        if (scale >= 2.5) return;
        scale += 0.25;
        zoomText.textContent = Math.round(scale * 100) + '%';
        queueRenderPage(pageNum);
      });

      document.getElementById('zoom-out').addEventListener('click', function() {
        if (scale <= 0.6) return;
        scale -= 0.25;
        zoomText.textContent = Math.round(scale * 100) + '%';
        queueRenderPage(pageNum);
      });

      toggleFlipBtn.addEventListener('click', function() {
        isFlipMode = !isFlipMode;
        if (isFlipMode) {
          flipLabel.textContent = 'الوضع الافتراضي';
          canvas.classList.add('flip-mode');
        } else {
          flipLabel.textContent = 'وضع التقليب';
          canvas.classList.remove('flip-mode');
        }
      });

      const closeToastBtn = document.getElementById('close-toast');
      if (closeToastBtn) {
        closeToastBtn.addEventListener('click', () => {
          resumeToast.classList.add('hidden');
        });
      }

      // دعم مفاتيح الأسهم للتنقل السلس
      window.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight' || e.key === 'PageUp') {
          onNextPage();
        } else if (e.key === 'ArrowLeft' || e.key === 'PageDown') {
          onPrevPage();
        }
      });

      // تحميل مستند الـ PDF
      pdfjsLib.getDocument(fileUrl).promise.then(function(pdfDoc_) {
        pdfDoc = pdfDoc_;
        pageCountSpan.textContent = pdfDoc.numPages;
        if (pageNum > pdfDoc.numPages) pageNum = 1;
        renderPage(pageNum);
      }).catch(function(error) {
        loader.innerHTML = '<span class="text-red-400">حدث خطأ أثناء تحميل ملف الـ PDF. يرجى التأكد من الرابط.</span>';
      });
    </script>
  </body>
</html>
