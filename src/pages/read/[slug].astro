---
import { getItemBySlug } from '../../lib/db';
import { useTranslations, type Language } from '../../lib/i18n';

const { slug } = Astro.params;
const url = new URL(Astro.request.url);
const lang = (url.searchParams.get('lang') as Language) || 'ar';
const t = useTranslations(lang);

const book = await getItemBySlug(slug as string, lang);

if (!book || (book.type !== 'book' && !book.file_url)) {
  return Astro.redirect(lang === 'en' ? '/books?lang=en' : '/books');
}

const isRTL = lang === 'ar';
const hasTOC = book.table_of_contents && book.table_of_contents.length > 0;
---

<!doctype html>
<html lang={lang} dir={isRTL ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isRTL ? `قراءة: ${book.title}` : `Read: ${book.title}`} | {isRTL ? 'مكتبة محمد رمضان' : 'Mohamed Ramadan Library'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PDF.js CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #1F2937;
        font-family: system-ui, -apple-system, sans-serif;
        overflow: hidden;
      }
      #viewer-container {
        height: calc(100vh - 60px);
        overflow: auto;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 20px 10px;
        box-sizing: border-box;
      }
      #pdf-canvas {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        background: white;
        border-radius: 4px;
        max-width: 100%;
      }
      .flip-mode {
        perspective: 1500px;
      }
      .flip-anim {
        transition: transform 0.35s ease-in-out;
      }
    </style>
  </head>
  <body class="flex flex-col h-screen select-none">
    
    <!-- شريط أدوات القارئ العلوي (Reader Toolbar) -->
    <header class="h-[60px] bg-[#143D33] text-white flex items-center justify-between px-3 sm:px-6 z-30 shrink-0 border-b border-[#B8924A]/40 shadow-md">
      
      <!-- اسم الكتاب والعودة -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={`/books/${book.slug}${lang === 'en' ? '?lang=en' : ''}`}
          class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors text-white"
          title={isRTL ? 'العودة لصفحة الكتاب' : 'Back to book page'}
        >
          <svg class="w-5 h-5 rtl:rotate-0 ltr:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        </a>
        <div class="max-w-[140px] sm:max-w-xs md:max-w-md truncate">
          <h1 class="font-bold text-xs sm:text-sm text-white truncate">{book.title}</h1>
          <span class="text-[10px] text-[#B8924A]">{isRTL ? 'المؤلف:' : 'Author:'} {book.author}</span>
        </div>
      </div>

      <!-- أدوات التنقل بين الصفحات -->
      <div class="flex items-center gap-1 sm:gap-2 text-xs">
        <button
          id="prev-page"
          class="px-2 sm:px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
          title={isRTL ? 'الصفحة السابقة' : 'Previous page'}
        >
          {isRTL ? 'السابق' : 'Prev'}
        </button>

        <div class="flex items-center gap-1 font-sans">
          <input
            type="number"
            id="page-num"
            value="1"
            min="1"
            class="w-10 sm:w-12 text-center py-1 bg-white/10 border border-white/20 rounded text-white text-xs font-bold"
          />
          <span class="text-white/60">/</span>
          <span id="page-count" class="text-white/80">--</span>
        </div>

        <button
          id="next-page"
          class="px-2 sm:px-3 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
          title={isRTL ? 'الصفحة التالية' : 'Next page'}
        >
          {isRTL ? 'التالي' : 'Next'}
        </button>
      </div>

      <!-- أدوات التكبير والفهرس والملء للشاشة -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        
        <!-- شارة طبيعة الملف: نصي / ممسوح ضوئياً -->
        <div id="pdf-type-badge" class="hidden md:flex items-center gap-1 px-2 py-1 rounded text-[10px] font-bold bg-white/10 text-white/80">
          <span id="pdf-type-icon">🔍</span>
          <span id="pdf-type-text">جارٍ الفحص...</span>
        </div>

        <!-- زر الفهرس (Table of Contents) إن وجد -->
        {hasTOC && (
          <button
            id="toggle-toc-btn"
            class="px-2 sm:px-2.5 py-1.5 text-xs rounded bg-white/10 hover:bg-white/20 text-white font-bold transition-colors"
            title={isRTL ? 'فهرس الموضوعات' : 'Table of Contents'}
          >
            {isRTL ? 'الفهرس' : 'TOC'}
          </button>
        )}

        <!-- أدوات التكبير -->
        <div class="hidden lg:flex items-center gap-1 bg-white/10 p-1 rounded-lg">
          <button id="zoom-out" class="px-2 py-1 hover:bg-white/10 rounded font-bold" title={isRTL ? 'تصغير' : 'Zoom out'}>-</button>
          <span id="zoom-text" class="text-[11px] font-sans px-1">100%</span>
          <button id="zoom-in" class="px-2 py-1 hover:bg-white/10 rounded font-bold" title={isRTL ? 'تكبير' : 'Zoom in'}>+</button>
        </div>

        <!-- تبديل ملء الشاشة -->
        <button
          id="toggle-fullscreen"
          class="p-2 rounded bg-white/10 hover:bg-white/20 text-white hidden sm:inline-flex"
          title={isRTL ? 'ملء الشاشة' : 'Toggle Fullscreen'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>

        {book.allow_download && (
          <a
            href={book.file_url}
            download
            class="hidden sm:inline-flex p-2 rounded bg-white/10 hover:bg-white/20 text-white"
            title={isRTL ? 'تنزيل نسخة PDF' : 'Download PDF'}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </a>
        )}
      </div>

    </header>

    <!-- تنبيه النسخة الممسوحة ضوئياً عند الاقتضاء (Scanned Notice Banner) -->
    <div
      id="scanned-notice"
      class="hidden bg-amber-900/90 text-amber-100 text-xs py-2 px-4 text-center border-b border-amber-600/50 flex items-center justify-center gap-2"
    >
      <span>⚠️</span>
      <span>
        {isRTL 
          ? 'تنبيه أكاديمي: هذا المصنف ممسوح ضوئياً (Scanned PDF) — البحث النصي الداخلي غير متاح، وتتم القراءة عبر النسخة البصرية المصورة.' 
          : 'Scholarly notice: This document is a scanned image PDF — full-text search is unavailable; visual reading mode is active.'}
      </span>
      <button id="dismiss-scanned-notice" class="underline hover:text-white mr-2 ml-2">
        {isRTL ? 'إغلاق' : 'Dismiss'}
      </button>
    </div>

    <!-- درج الفهرس الجانبي (TOC Drawer) -->
    {hasTOC && (
      <aside
        id="toc-drawer"
        class="hidden fixed top-[60px] right-0 bottom-0 w-72 bg-[#143D33] text-white border-l border-[#B8924A]/40 z-40 p-4 shadow-2xl overflow-y-auto"
      >
        <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-4">
          <h2 class="font-bold text-sm text-[#B8924A]">{isRTL ? 'فهرس المحتويات' : 'Table of Contents'}</h2>
          <button id="close-toc-btn" class="text-white/70 hover:text-white text-xs">✕</button>
        </div>
        <ul class="space-y-2 text-xs">
          {book.table_of_contents.map((item) => (
            <li>
              <button
                type="button"
                class="toc-item-btn w-full text-right rtl:text-right ltr:text-left p-2 rounded hover:bg-white/10 flex items-center justify-between text-white/90 transition-colors"
                data-page={item.page || 1}
              >
                <span class="truncate">{item.title}</span>
                {item.page && <span class="font-mono text-[#B8924A] shrink-0 font-bold">{item.page}</span>}
              </button>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <!-- منطقة عرض صفحات الكتاب -->
    <div id="viewer-container" class="relative">
      <div id="loading-indicator" class="text-white text-sm mt-20 flex flex-col items-center gap-3">
        <div class="w-8 h-8 border-4 border-[#B8924A] border-t-transparent rounded-full animate-spin"></div>
        <span>{isRTL ? 'جارٍ تهيئة صفحات الكتاب بدقة عالية...' : 'Loading book pages in high resolution...'}</span>
      </div>
      <canvas id="pdf-canvas" class="hidden"></canvas>
    </div>

    <!-- إشعار استكمال القراءة الذاتي -->
    <div
      id="resume-toast"
      class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-[#143D33] text-white border border-[#B8924A] px-5 py-3 rounded-xl shadow-2xl z-50 text-xs flex items-center gap-4"
    >
      <span>{isRTL ? 'تم استئناف القراءة تلقائياً من الصفحة التي توقفت عندها.' : 'Resumed reading from your last saved page.'}</span>
      <button id="close-toast" class="text-[#B8924A] font-bold hover:underline">{isRTL ? 'حسناً' : 'OK'}</button>
    </div>

    <script is:inline define:vars={{ fileUrl: book.file_url, bookSlug: book.slug, isRTL }}>
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

      let pdfDoc = null;
      let pageNum = 1;
      let pageRendering = false;
      let pageNumPending = null;
      let scale = 1.25;

      const canvas = document.getElementById('pdf-canvas');
      const ctx = canvas.getContext('2d');
      const loader = document.getElementById('loading-indicator');
      const pageNumInput = document.getElementById('page-num');
      const pageCountSpan = document.getElementById('page-count');
      const zoomText = document.getElementById('zoom-text');
      const prevBtn = document.getElementById('prev-page');
      const nextBtn = document.getElementById('next-page');
      const resumeToast = document.getElementById('resume-toast');
      const scannedNotice = document.getElementById('scanned-notice');
      const pdfTypeBadge = document.getElementById('pdf-type-badge');
      const pdfTypeText = document.getElementById('pdf-type-text');
      const pdfTypeIcon = document.getElementById('pdf-type-icon');

      // حساب مقياس ملائم للشاشات الصغيرة
      if (window.innerWidth < 640) {
        scale = 0.85;
      }

      // استرجاع موضع القراءة
      const savedPage = localStorage.getItem(`read_pos_${bookSlug}`);
      if (savedPage) {
        const parsed = parseInt(savedPage);
        if (!isNaN(parsed) && parsed > 1) {
          pageNum = parsed;
          if (resumeToast) resumeToast.classList.remove('hidden');
        }
      }

      // التحقق مما إذا كان الملف ممسوحاً ضوئياً (Scanned image vs Text extractable)
      async function detectScannedPDF(doc) {
        try {
          const samplePage = await doc.getPage(Math.min(2, doc.numPages));
          const textContent = await samplePage.getTextContent();
          const hasText = textContent.items && textContent.items.length > 5;

          if (pdfTypeBadge && pdfTypeText && pdfTypeIcon) {
            pdfTypeBadge.classList.remove('hidden');
            if (hasText) {
              pdfTypeIcon.textContent = '📄';
              pdfTypeText.textContent = isRTL ? 'نسخة نصية' : 'Text PDF';
            } else {
              pdfTypeIcon.textContent = '📷';
              pdfTypeText.textContent = isRTL ? 'نسخة ممسوحة' : 'Scanned PDF';
              if (scannedNotice) scannedNotice.classList.remove('hidden');
            }
          }
        } catch (e) {
          console.warn('Could not inspect text content', e);
        }
      }

      function renderPage(num) {
        pageRendering = true;
        pdfDoc.getPage(num).then(function(page) {
          const viewport = page.getViewport({ scale: scale });
          canvas.height = viewport.height;
          canvas.width = viewport.width;

          const renderContext = {
            canvasContext: ctx,
            viewport: viewport
          };
          const renderTask = page.render(renderContext);

          renderTask.promise.then(function() {
            pageRendering = false;
            loader.classList.add('hidden');
            canvas.classList.remove('hidden');

            localStorage.setItem(`read_pos_${bookSlug}`, num.toString());

            if (pageNumPending !== null) {
              renderPage(pageNumPending);
              pageNumPending = null;
            }
          });
        });

        pageNumInput.value = num;
        prevBtn.disabled = (num <= 1);
        nextBtn.disabled = (num >= pdfDoc.numPages);
      }

      function queueRenderPage(num) {
        if (pageRendering) {
          pageNumPending = num;
        } else {
          renderPage(num);
        }
      }

      function onPrevPage() {
        if (pageNum <= 1) return;
        pageNum--;
        queueRenderPage(pageNum);
      }

      function onNextPage() {
        if (pageNum >= pdfDoc.numPages) return;
        pageNum++;
        queueRenderPage(pageNum);
      }

      prevBtn.addEventListener('click', onPrevPage);
      nextBtn.addEventListener('click', onNextPage);

      pageNumInput.addEventListener('change', function() {
        let desired = parseInt(this.value);
        if (desired >= 1 && desired <= pdfDoc.numPages) {
          pageNum = desired;
          queueRenderPage(pageNum);
        } else {
          this.value = pageNum;
        }
      });

      const zoomInBtn = document.getElementById('zoom-in');
      const zoomOutBtn = document.getElementById('zoom-out');
      if (zoomInBtn) {
        zoomInBtn.addEventListener('click', function() {
          if (scale >= 2.5) return;
          scale += 0.25;
          if (zoomText) zoomText.textContent = Math.round(scale * 100) + '%';
          queueRenderPage(pageNum);
        });
      }

      if (zoomOutBtn) {
        zoomOutBtn.addEventListener('click', function() {
          if (scale <= 0.6) return;
          scale -= 0.25;
          if (zoomText) zoomText.textContent = Math.round(scale * 100) + '%';
          queueRenderPage(pageNum);
        });
      }

      // ملء الشاشة
      const fsBtn = document.getElementById('toggle-fullscreen');
      if (fsBtn) {
        fsBtn.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });
      }

      // الفهرس الجانبي
      const toggleTocBtn = document.getElementById('toggle-toc-btn');
      const tocDrawer = document.getElementById('toc-drawer');
      const closeTocBtn = document.getElementById('close-toc-btn');
      if (toggleTocBtn && tocDrawer) {
        toggleTocBtn.addEventListener('click', () => {
          tocDrawer.classList.toggle('hidden');
        });
      }
      if (closeTocBtn && tocDrawer) {
        closeTocBtn.addEventListener('click', () => {
          tocDrawer.classList.add('hidden');
        });
      }

      document.querySelectorAll('.toc-item-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetPage = parseInt(btn.dataset.page || '1');
          if (!isNaN(targetPage) && targetPage >= 1 && targetPage <= (pdfDoc ? pdfDoc.numPages : 1000)) {
            pageNum = targetPage;
            queueRenderPage(pageNum);
            if (tocDrawer) tocDrawer.classList.add('hidden');
          }
        });
      });

      const dismissNoticeBtn = document.getElementById('dismiss-scanned-notice');
      if (dismissNoticeBtn && scannedNotice) {
        dismissNoticeBtn.addEventListener('click', () => {
          scannedNotice.classList.add('hidden');
        });
      }

      const closeToastBtn = document.getElementById('close-toast');
      if (closeToastBtn && resumeToast) {
        closeToastBtn.addEventListener('click', () => {
          resumeToast.classList.add('hidden');
        });
      }

      // دعم مفاتيح الأسهم
      window.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowRight' || e.key === 'PageUp') {
          onNextPage();
        } else if (e.key === 'ArrowLeft' || e.key === 'PageDown') {
          onPrevPage();
        }
      });

      // لمس الشاشة (Touch Swipe) للهواتف
      let touchStartX = 0;
      window.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });
      window.addEventListener('touchend', (e) => {
        const diff = e.changedTouches[0].screenX - touchStartX;
        if (Math.abs(diff) > 60) {
          if (diff > 0) {
            isRTL ? onNextPage() : onPrevPage();
          } else {
            isRTL ? onPrevPage() : onNextPage();
          }
        }
      }, { passive: true });

      // تحميل مستند الـ PDF
      pdfjsLib.getDocument(fileUrl).promise.then(function(pdfDoc_) {
        pdfDoc = pdfDoc_;
        pageCountSpan.textContent = pdfDoc.numPages;
        if (pageNum > pdfDoc.numPages) pageNum = 1;
        renderPage(pageNum);
        detectScannedPDF(pdfDoc);
      }).catch(function(error) {
        loader.innerHTML = '<span class="text-red-400 font-bold p-4 bg-red-900/40 rounded-xl border border-red-500">' + 
          (isRTL ? 'تعذر تحميل ملف الـ PDF. يرجى التحقق من الاتصال بالشبكة.' : 'Failed to load PDF document. Please verify your connection.') + 
          '</span>';
      });
    </script>
  </body>
</html>
