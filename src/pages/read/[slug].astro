---
import '../../styles/global.css';
import { getItemBySlug } from '../../lib/db';
import { useTranslations, type Language } from '../../lib/i18n';

const { slug } = Astro.params;
const url = new URL(Astro.request.url);
const lang = (url.searchParams.get('lang') as Language) || 'ar';
const t = useTranslations(lang);

const book = await getItemBySlug(slug as string, lang);

const hasPdf = Boolean(book && book.file_url && book.file_url.trim());
const hasText = Boolean(book && book.content && book.content.trim());

if (!book || (!hasPdf && !hasText)) {
  return Astro.redirect(lang === 'en' ? '/books?lang=en' : '/books');
}

const isRTL = lang === 'ar';
const hasTOC = book.table_of_contents && book.table_of_contents.length > 0;
// الوضع الافتراضي: القراءة النصية إذا توفرت، وإلا نسخة الـ PDF
const defaultMode = hasText ? 'text' : 'pdf';
---

<!doctype html>
<html lang={lang} dir={isRTL ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isRTL ? `قراءة: ${book.title}` : `Read: ${book.title}`} | {isRTL ? 'مكتبة محمد رمضان' : 'Mohamed Ramadan Library'}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hasPdf && (
      <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    )}
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: system-ui, -apple-system, sans-serif;
        overflow: hidden;
      }
      #viewer-container {
        height: calc(100vh - 60px);
        overflow: auto;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 20px 10px;
        box-sizing: border-box;
        background-color: #1F2937;
      }
      #pdf-canvas {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        background: white;
        border-radius: 4px;
        max-width: 100%;
      }
      /* ثيمات وضع القراءة النصية المريحة للعين */
      .theme-parchment {
        background-color: #F7F3E9 !important;
        color: #1E293B !important;
      }
      .theme-dark {
        background-color: #121820 !important;
        color: #E2E8F0 !important;
      }
      .theme-dark .academic-reader-content h2 {
        color: #6EE7B7 !important;
      }
      .theme-dark .academic-reader-content h3 {
        color: #93C5FD !important;
      }
      .theme-dark .academic-reader-content blockquote {
        background-color: #1A2433 !important;
        color: #BAE6FD !important;
      }
      .theme-white {
        background-color: #FFFFFF !important;
        color: #1E293B !important;
      }
    </style>
  </head>
  <body class="flex flex-col h-screen select-none theme-parchment">
    
    <!-- شريط تقدم القراءة في أعلى الشاشة -->
    <div id="reading-progress-bar" class="fixed top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#B8924A] to-[#143D33] z-50 transition-all duration-150" style="width: 0%;"></div>

    <!-- شريط أدوات القارئ العلوي (Reader Toolbar) -->
    <header class="h-[60px] bg-[#143D33] text-white flex items-center justify-between px-3 sm:px-6 z-30 shrink-0 border-b border-[#B8924A]/40 shadow-md">
      
      <!-- اسم الكتاب والعودة -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href={`/books/${book.slug}${lang === 'en' ? '?lang=en' : ''}`}
          class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition-colors text-white flex items-center gap-1 text-xs font-bold"
          title={isRTL ? 'العودة لصفحة الكتاب' : 'Back to book page'}
        >
          <svg class="w-4 h-4 rtl:rotate-0 ltr:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span class="hidden md:inline">{isRTL ? 'صفحة الكتاب' : 'Back'}</span>
        </a>

        <div class="max-w-[130px] sm:max-w-xs md:max-w-sm truncate">
          <h1 class="font-bold text-xs sm:text-sm text-white truncate">{book.title}</h1>
          <span class="text-[10px] text-[#B8924A]">{isRTL ? 'المؤلف:' : 'Author:'} {book.author}</span>
        </div>
      </div>

      <!-- محول الوضع: قراءة نصية مريحة vs نسخة PDF (إن توفر الاثنان) -->
      {hasText && hasPdf && (
        <div class="flex items-center bg-white/10 p-1 rounded-xl border border-white/20 text-xs font-bold">
          <button
            type="button"
            id="btn-mode-text"
            class="px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer bg-white text-[#143D33] shadow-sm"
          >
            <span>📖</span>
            <span class="hidden sm:inline">{isRTL ? 'قراءة نصية مريحة' : 'Digital Reader'}</span>
          </button>
          <button
            type="button"
            id="btn-mode-pdf"
            class="px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer text-white/80 hover:text-white"
          >
            <span>📄</span>
            <span class="hidden sm:inline">{isRTL ? 'نسخة PDF المصورة' : 'PDF Viewer'}</span>
          </button>
        </div>
      )}

      <!-- أدوات التحكم في القراءة النصية (تظهر عند تفعيل الوضع النصي) -->
      <div id="text-controls" class={`${defaultMode === 'text' ? 'flex' : 'hidden'} items-center gap-2 text-xs`}>
        <!-- اختيار حجم الخط للقراءة النصية -->
        <div class="flex items-center gap-1 bg-white/10 px-2 py-1 rounded-lg border border-white/10 text-xs">
          <button id="text-font-dec" class="w-6 h-6 flex items-center justify-center font-bold hover:bg-white/20 rounded cursor-pointer" title="تصغير الخط">A-</button>
          <span id="text-font-size" class="text-[10px] text-white/80 px-1 font-mono">100%</span>
          <button id="text-font-inc" class="w-6 h-6 flex items-center justify-center font-bold hover:bg-white/20 rounded cursor-pointer" title="تكبير الخط">A+</button>
        </div>

        <!-- اختيار ثيم الخلفية للقراءة المريحة -->
        <div class="flex items-center gap-1 bg-white/10 p-1 rounded-lg border border-white/10">
          <button type="button" data-theme="parchment" class="theme-btn w-6 h-6 rounded-full bg-[#F7F3E9] border border-amber-300 hover:scale-110 transition-transform cursor-pointer" title="وضع الورق التراثي المذهب"></button>
          <button type="button" data-theme="dark" class="theme-btn w-6 h-6 rounded-full bg-[#121820] border border-gray-600 hover:scale-110 transition-transform cursor-pointer" title="وضع القراءة الليلية"></button>
          <button type="button" data-theme="white" class="theme-btn w-6 h-6 rounded-full bg-white border border-gray-300 hover:scale-110 transition-transform cursor-pointer" title="وضع القراءة الصافية"></button>
        </div>

        <!-- ملء الشاشة -->
        <button
          type="button"
          id="btn-fullscreen"
          class="p-2 rounded bg-white/10 hover:bg-white/20 text-white cursor-pointer"
          title="ملء الشاشة"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
          </svg>
        </button>
      </div>

      <!-- أدوات التحكم في ملف الـ PDF (تظهر عند تفعيل وضع الـ PDF) -->
      {hasPdf && (
        <div id="pdf-controls" class={`${defaultMode === 'pdf' ? 'flex' : 'hidden'} items-center gap-2 text-xs`}>
          <!-- أزرار التنقل بين الصفحات -->
          <div class="flex items-center gap-1">
            <button
              id="prev-page"
              class="px-2.5 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
              title="الصفحة السابقة"
            >
              {isRTL ? 'السابق' : 'Prev'}
            </button>
            <div class="flex items-center gap-1 font-sans">
              <input
                type="number"
                id="page-num"
                value="1"
                min="1"
                class="w-10 sm:w-12 text-center py-1 bg-white/10 border border-white/20 rounded text-white text-xs font-bold"
              />
              <span class="text-white/60">/</span>
              <span id="page-count" class="text-white/80">--</span>
            </div>
            <button
              id="next-page"
              class="px-2.5 py-1.5 rounded bg-white/10 hover:bg-white/20 font-bold transition-colors disabled:opacity-40"
              title="الصفحة التالية"
            >
              {isRTL ? 'التالي' : 'Next'}
            </button>
          </div>

          <!-- أدوات التكبير -->
          <div class="hidden lg:flex items-center gap-1 bg-white/10 p-1 rounded-lg">
            <button id="zoom-out" class="px-2 py-0.5 hover:bg-white/10 rounded font-bold" title="تصغير">-</button>
            <span id="zoom-text" class="text-[11px] font-sans px-1">100%</span>
            <button id="zoom-in" class="px-2 py-0.5 hover:bg-white/10 rounded font-bold" title="تكبير">+</button>
          </div>

          {book.allow_download && (
            <a
              href={book.file_url}
              download
              class="hidden sm:inline-flex p-2 rounded bg-white/10 hover:bg-white/20 text-white"
              title="تنزيل نسخة PDF"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
            </a>
          )}
        </div>
      )}

    </header>

    <!-- 1. منطقة القراءة النصية الأكاديمية الرقمية (Digital Reading Canvas) -->
    {hasText && (
      <main
        id="text-reader-container"
        class={`${defaultMode === 'text' ? 'block' : 'hidden'} overflow-y-auto h-[calc(100vh-60px)] transition-colors duration-200 select-text`}
      >
        <div class="max-w-4xl mx-auto px-5 sm:px-10 lg:px-14 py-12">
          
          <!-- بطاقة رأسية لبيانات العمل -->
          <div class="pb-8 mb-10 border-b border-[#B8924A]/30">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#143D33]/10 text-[#143D33] text-xs font-bold mb-3">
              <span>📖</span>
              <span>{isRTL ? 'متن الكتاب والمنهج الأكاديمي' : 'Complete Digital Edition'}</span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-amiri font-bold text-[#143D33] leading-tight">
              {book.title}
            </h1>
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-[#5A6578] mt-4">
              <span>{isRTL ? 'المؤلف:' : 'Author:'} <strong class="text-[#143D33] font-bold">{book.author}</strong></span>
              {book.page_count && <span>• {book.page_count} {t.pageUnit}</span>}
              {book.published_at && <span>• {new Date(book.published_at).toLocaleDateString(isRTL ? 'ar-EG' : 'en-US', { year: 'numeric', month: 'long' })}</span>}
            </div>
          </div>

          <!-- متن العمل המنسق بأعلى معايير الراحة للعين -->
          <article id="text-reader-content" class="academic-reader-content">
            <div set:html={book.content} />
          </article>

          <!-- خاتمة القراءة والعودة -->
          <div class="mt-16 pt-8 border-t border-[#B8924A]/30 flex flex-wrap items-center justify-between gap-4 text-xs text-[#5A6578]">
            <span class="font-amiri font-bold text-sm text-[#143D33]">
              منصة مكتبة محمد رمضان المعرفية الرقمية
            </span>
            <button
              type="button"
              onclick="document.getElementById('text-reader-container').scrollTo({ top: 0, behavior: 'smooth' })"
              class="px-4 py-2 bg-[#143D33] hover:bg-[#1F5A4B] text-white font-bold rounded-xl transition-colors flex items-center gap-1.5 cursor-pointer shadow-sm"
            >
              <span>↑</span>
              <span>{isRTL ? 'العودة لأعلى الصفحة' : 'Back to top'}</span>
            </button>
          </div>

        </div>
      </main>
    )}

    <!-- 2. منطقة عرض ملف الـ PDF (PDF Document Viewer) -->
    {hasPdf && (
      <div
        id="viewer-container"
        class={`${defaultMode === 'pdf' ? 'flex' : 'hidden'} relative`}
      >
        <div id="loading-indicator" class="text-white text-sm mt-20 flex flex-col items-center gap-3">
          <div class="w-8 h-8 border-4 border-[#B8924A] border-t-transparent rounded-full animate-spin"></div>
          <span>{isRTL ? 'جارٍ تهيئة صفحات الكتاب بدقة عالية...' : 'Loading book pages in high resolution...'}</span>
        </div>
        <canvas id="pdf-canvas" class="hidden"></canvas>
      </div>
    )}

    <script is:inline define:vars={{ fileUrl: book.file_url, bookSlug: book.slug, isRTL, hasText, hasPdf, defaultMode }}>
      // 1. التحكم في ثيمات القراءة وحجم الخط في الوضع النصي
      const textContainer = document.getElementById('text-reader-container');
      const textContent = document.getElementById('text-reader-content');
      const textFontInc = document.getElementById('text-font-inc');
      const textFontDec = document.getElementById('text-font-dec');
      const textFontSizeLabel = document.getElementById('text-font-size');
      const progressBar = document.getElementById('reading-progress-bar');
      let currentFontSize = 19.2;

      // تطبيق الثيم المحفوظ
      const savedTheme = localStorage.getItem('library_reader_theme') || 'parchment';
      document.body.className = `flex flex-col h-screen select-none theme-${savedTheme}`;

      document.querySelectorAll('.theme-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const theme = btn.dataset.theme;
          document.body.className = `flex flex-col h-screen select-none theme-${theme}`;
          localStorage.setItem('library_reader_theme', theme);
        });
      });

      // ضبط حجم الخط
      if (textFontInc && textFontDec && textContent) {
        textFontInc.addEventListener('click', () => {
          if (currentFontSize < 28) {
            currentFontSize += 2;
            textContent.style.fontSize = `${currentFontSize}px`;
            if (textFontSizeLabel) textFontSizeLabel.textContent = `${Math.round((currentFontSize / 19.2) * 100)}%`;
          }
        });

        textFontDec.addEventListener('click', () => {
          if (currentFontSize > 15) {
            currentFontSize -= 2;
            textContent.style.fontSize = `${currentFontSize}px`;
            if (textFontSizeLabel) textFontSizeLabel.textContent = `${Math.round((currentFontSize / 19.2) * 100)}%`;
          }
        });
      }

      // شريط تقدم القراءة النصية
      if (textContainer && progressBar) {
        textContainer.addEventListener('scroll', () => {
          const totalHeight = textContainer.scrollHeight - textContainer.clientHeight;
          if (totalHeight > 0) {
            const progress = (textContainer.scrollTop / totalHeight) * 100;
            progressBar.style.width = `${progress}%`;
          }
        });
      }

      // 2. التبديل بين وضع القراءة النصية ووضع الـ PDF
      const btnModeText = document.getElementById('btn-mode-text');
      const btnModePdf = document.getElementById('btn-mode-pdf');
      const viewerContainer = document.getElementById('viewer-container');
      const textControls = document.getElementById('text-controls');
      const pdfControls = document.getElementById('pdf-controls');

      function switchMode(mode) {
        if (mode === 'text' && textContainer) {
          textContainer.classList.remove('hidden');
          textContainer.classList.add('block');
          if (viewerContainer) viewerContainer.classList.add('hidden');
          if (textControls) textControls.classList.remove('hidden');
          if (textControls) textControls.classList.add('flex');
          if (pdfControls) pdfControls.classList.add('hidden');

          if (btnModeText) {
            btnModeText.className = 'px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer bg-white text-[#143D33] shadow-sm';
          }
          if (btnModePdf) {
            btnModePdf.className = 'px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer text-white/80 hover:text-white';
          }
        } else if (mode === 'pdf' && viewerContainer) {
          viewerContainer.classList.remove('hidden');
          viewerContainer.classList.add('flex');
          if (textContainer) {
            textContainer.classList.remove('block');
            textContainer.classList.add('hidden');
          }
          if (pdfControls) pdfControls.classList.remove('hidden');
          if (pdfControls) pdfControls.classList.add('flex');
          if (textControls) {
            textControls.classList.remove('flex');
            textControls.classList.add('hidden');
          }

          if (btnModePdf) {
            btnModePdf.className = 'px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer bg-white text-[#143D33] shadow-sm';
          }
          if (btnModeText) {
            btnModeText.className = 'px-3 py-1 rounded-lg transition-all flex items-center gap-1 cursor-pointer text-white/80 hover:text-white';
          }
        }
      }

      if (btnModeText) btnModeText.addEventListener('click', () => switchMode('text'));
      if (btnModePdf) btnModePdf.addEventListener('click', () => switchMode('pdf'));

      // 3. ملء الشاشة
      const btnFullscreen = document.getElementById('btn-fullscreen');
      if (btnFullscreen) {
        btnFullscreen.addEventListener('click', () => {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else {
            document.exitFullscreen().catch(() => {});
          }
        });
      }

      // 4. تشغيل محرك PDF.js فقط في حال وجود ملف PDF
      if (hasPdf && fileUrl) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        let pdfDoc = null;
        let pageNum = 1;
        let pageRendering = false;
        let pageNumPending = null;
        let scale = window.innerWidth < 640 ? 0.85 : 1.25;

        const canvas = document.getElementById('pdf-canvas');
        const ctx = canvas ? canvas.getContext('2d') : null;
        const loader = document.getElementById('loading-indicator');
        const pageNumInput = document.getElementById('page-num');
        const pageCountSpan = document.getElementById('page-count');
        const zoomText = document.getElementById('zoom-text');
        const prevBtn = document.getElementById('prev-page');
        const nextBtn = document.getElementById('next-page');

        function renderPage(num) {
          if (!pdfDoc || !canvas || !ctx) return;
          pageRendering = true;
          pdfDoc.getPage(num).then(function(page) {
            const viewport = page.getViewport({ scale: scale });
            canvas.height = viewport.height;
            canvas.width = viewport.width;

            const renderContext = {
              canvasContext: ctx,
              viewport: viewport
            };
            const renderTask = page.render(renderContext);

            renderTask.promise.then(function() {
              pageRendering = false;
              if (loader) loader.classList.add('hidden');
              canvas.classList.remove('hidden');

              localStorage.setItem(`read_pos_${bookSlug}`, num.toString());

              if (pageNumPending !== null) {
                renderPage(pageNumPending);
                pageNumPending = null;
              }
            });
          });

          if (pageNumInput) pageNumInput.value = num;
          if (prevBtn) prevBtn.disabled = (num <= 1);
          if (nextBtn) nextBtn.disabled = (num >= pdfDoc.numPages);
        }

        function queueRenderPage(num) {
          if (pageRendering) {
            pageNumPending = num;
          } else {
            renderPage(num);
          }
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (pageNum <= 1) return;
            pageNum--;
            queueRenderPage(pageNum);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
            pageNum++;
            queueRenderPage(pageNum);
          });
        }

        if (pageNumInput) {
          pageNumInput.addEventListener('change', function() {
            let desired = parseInt(this.value);
            if (pdfDoc && desired >= 1 && desired <= pdfDoc.numPages) {
              pageNum = desired;
              queueRenderPage(pageNum);
            } else {
              this.value = pageNum;
            }
          });
        }

        const zoomInBtn = document.getElementById('zoom-in');
        const zoomOutBtn = document.getElementById('zoom-out');
        if (zoomInBtn) {
          zoomInBtn.addEventListener('click', () => {
            if (scale >= 2.5) return;
            scale += 0.25;
            if (zoomText) zoomText.textContent = Math.round(scale * 100) + '%';
            queueRenderPage(pageNum);
          });
        }
        if (zoomOutBtn) {
          zoomOutBtn.addEventListener('click', () => {
            if (scale <= 0.6) return;
            scale -= 0.25;
            if (zoomText) zoomText.textContent = Math.round(scale * 100) + '%';
            queueRenderPage(pageNum);
          });
        }

        pdfjsLib.getDocument(fileUrl).promise.then(function(pdfDoc_) {
          pdfDoc = pdfDoc_;
          if (pageCountSpan) pageCountSpan.textContent = pdfDoc.numPages;
          renderPage(pageNum);
        }).catch(function(error) {
          if (loader) {
            loader.innerHTML = '<span class="text-red-400 font-bold p-4 bg-red-900/40 rounded-xl border border-red-500">' + 
              (isRTL ? 'تعذر تحميل ملف الـ PDF عبر المتصفح. يمكنك القراءة عبر الوضع النصي.' : 'Failed to load PDF document. Please use Digital Reader mode.') + 
              '</span>';
          }
        });
      }
    </script>
  </body>
</html>
