---
import Layout from '../../layouts/Layout.astro';
import { getItems } from '../../lib/db';

const literature = await getItems({ type: 'literature' });
---

<Layout title="الأعمال الأدبية والإبداعية">
  <div class="bg-[#143D33] text-[#F7F3E9] py-12 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">سرد ونصوص إبداعية</span>
        <h1 class="text-3xl sm:text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">الأعمال الأدبية</h1>
        <p class="text-sm text-[#F7F3E9]/80 mt-2 leading-relaxed">
          نصوص سردية وروايات ومشروعات إبداعية، تحتفي بجماليات اللغة والأفق الحضاري.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    {literature.map((lit) => (
      <article class="p-6 bg-white dark:bg-[#1A2433] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm hover:border-[#B8924A] transition-colors">
        <h2 class="text-2xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] hover:text-[#B8924A] transition-colors">
          <a href={`/literature/${lit.slug}`}>{lit.title}</a>
        </h2>
        <p class="text-sm text-[#5A6578] dark:text-gray-300 mt-2 leading-relaxed">
          {lit.excerpt}
        </p>
        <div class="mt-4 pt-3 border-t border-[#E2DCD0]/60 flex items-center justify-between">
          <span class="text-xs text-[#5A6578]">المؤلف: {lit.author}</span>
          <a href={`/literature/${lit.slug}`} class="text-xs font-bold text-[#143D33] hover:underline">
            قراءة العمل الأدبي ←
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
