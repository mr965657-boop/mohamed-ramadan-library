---
import Layout from '../layouts/Layout.astro';
import { searchLibrary } from '../lib/db';
import { useTranslations, type Language } from '../lib/i18n';
import type { ItemType } from '../types/database';

const url = new URL(Astro.request.url);
const lang = (url.searchParams.get('lang') as Language) || 'ar';
const t = useTranslations(lang);

const query = url.searchParams.get('q') || '';
const selectedType = (url.searchParams.get('type') || undefined) as ItemType | undefined;

const results = query ? await searchLibrary(query, { type: selectedType, language: lang }) : [];

function buildUrl(params: Record<string, string>) {
  const u = new URL(Astro.request.url);
  for (const [k, v] of Object.entries(params)) {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  }
  return u.pathname + u.search;
}
---

<Layout title={query ? `${lang === 'ar' ? 'نتائج البحث عن' : 'Search results for'}: ${query}` : t.searchPageTitle} lang={lang}>
  <div class="bg-[#143D33] text-[#F7F3E9] py-12 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">{t.brandName}</span>
        <h1 class="text-3xl sm:text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">{t.searchPageTitle}</h1>
        <p class="text-sm text-[#F7F3E9]/80 mt-2 leading-relaxed">
          {t.searchPageSubtitle}
        </p>
      </div>

      <div class="mt-8 max-w-2xl">
        <form action="/search" method="GET" class="flex gap-2">
          <input
            type="search"
            name="q"
            value={query}
            placeholder={t.heroSearchPlaceholder}
            class="flex-1 px-4 py-3 rounded-xl bg-white text-[#151C24] text-sm focus:outline-none focus:ring-2 focus:ring-[#B8924A]"
            required
          />
          {lang === 'en' && <input type="hidden" name="lang" value="en" />}
          <button
            type="submit"
            class="px-6 py-3 bg-[#B8924A] text-[#143D33] font-bold text-sm rounded-xl hover:bg-[#D4B06A] transition-colors"
          >
            {t.searchBtn}
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- أزرار الفلترة والتصفية -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 text-xs no-scrollbar border-b border-[#E2DCD0]">
      <span class="font-bold text-[#5A6578]">{lang === 'ar' ? 'تصفية:' : 'Filter:'}</span>
      <a
        href={buildUrl({ q: query, type: '', lang })}
        class={`px-3 py-1.5 rounded-lg border font-medium ${!selectedType ? 'bg-[#143D33] text-white border-[#143D33]' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400'}`}
      >
        {t.filterAll}
      </a>
      <a
        href={buildUrl({ q: query, type: 'book', lang })}
        class={`px-3 py-1.5 rounded-lg border font-medium ${selectedType === 'book' ? 'bg-[#143D33] text-white border-[#143D33]' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400'}`}
      >
        {t.filterBooks}
      </a>
      <a
        href={buildUrl({ q: query, type: 'research', lang })}
        class={`px-3 py-1.5 rounded-lg border font-medium ${selectedType === 'research' ? 'bg-[#143D33] text-white border-[#143D33]' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400'}`}
      >
        {t.filterResearch}
      </a>
      <a
        href={buildUrl({ q: query, type: 'article', lang })}
        class={`px-3 py-1.5 rounded-lg border font-medium ${selectedType === 'article' ? 'bg-[#143D33] text-white border-[#143D33]' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400'}`}
      >
        {t.filterArticles}
      </a>
      <a
        href={buildUrl({ q: query, type: 'lecture', lang })}
        class={`px-3 py-1.5 rounded-lg border font-medium ${selectedType === 'lecture' ? 'bg-[#143D33] text-white border-[#143D33]' : 'bg-white text-gray-700 border-gray-200 hover:border-gray-400'}`}
      >
        {t.filterLectures}
      </a>
    </div>

    {query ? (
      <div>
        <p class="text-sm text-[#5A6578] mb-6">
          {t.resultsCount.replace('{count}', results.length.toString()).replace('{query}', query)}
        </p>

        {results.length > 0 ? (
          <div class="space-y-4">
            {results.map((item) => (
              <article class="p-5 bg-white dark:bg-[#1A2433] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] hover:shadow-md transition-shadow">
                <div class="flex items-center gap-2 text-xs text-[#B8924A] font-semibold mb-1">
                  <span class="px-2 py-0.5 rounded bg-[#FAF7F0] text-[#143D33] font-bold">
                    {item.type}
                  </span>
                  <span>{item.author}</span>
                </div>
                <h2 class="text-xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] hover:text-[#B8924A] transition-colors">
                  <a href={`/${item.type === 'book' ? 'books' : item.type === 'research' ? 'research' : item.type === 'article' ? 'articles' : item.type === 'lecture' ? 'lectures' : item.type === 'literature' ? 'literature' : 'educational'}/${item.slug}${lang === 'en' ? '?lang=en' : ''}`}>
                    {item.title}
                  </a>
                </h2>
                <p class="text-xs text-[#5A6578] dark:text-gray-300 mt-2 line-clamp-2 leading-relaxed">
                  {item.excerpt}
                </p>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-white dark:bg-[#1A2433] rounded-2xl border border-[#E2DCD0]">
            <p class="text-lg font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0]">{t.noResults}</p>
          </div>
        )}
      </div>
    ) : (
      <div class="text-center py-16 bg-white dark:bg-[#1A2433] rounded-2xl border border-[#E2DCD0]">
        <p class="text-lg font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0]">{t.enterSearchQuery}</p>
      </div>
    )}
  </div>
</Layout>
