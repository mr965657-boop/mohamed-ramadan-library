---
import Layout from '../../layouts/Layout.astro';
import { getItems } from '../../lib/db';

const lectures = await getItems({ type: 'lecture' });
---

<Layout title="المحاضرات والدروس الصوتية">
  <div class="bg-[#1B365D] text-[#F7F3E9] py-12 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">التسجيلات والدروس المسموعة</span>
        <h1 class="text-3xl sm:text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">المحاضرات والدروس الصوتية</h1>
        <p class="text-sm text-[#F7F3E9]/80 mt-2 leading-relaxed">
          سلاسل ودروس علمية مسموعة، تتيح الاستماع المباشر مع توفر التفريغ النصي المصاحب.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    {lectures.map((lec) => (
      <article class="p-6 bg-white dark:bg-[#1A2433] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between text-xs text-[#5A6578] mb-2">
          <span class="text-[#1B365D] font-bold">تسجيل صوتي MP3</span>
          <span>المدة: 6:12 دقيقة</span>
        </div>
        <h2 class="text-2xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] hover:text-[#1B365D] transition-colors">
          <a href={`/lectures/${lec.slug}`}>{lec.title}</a>
        </h2>
        <p class="text-sm text-[#5A6578] dark:text-gray-300 mt-2 leading-relaxed">
          {lec.excerpt}
        </p>
        
        <div class="mt-4 pt-3 border-t border-[#E2DCD0]/60 flex items-center justify-between">
          <audio controls class="w-full max-w-md h-9">
            <source src={lec.file_url || ''} type="audio/mpeg" />
            متصفحك لا يدعم مشغل الصوتيات.
          </audio>
          <a href={`/lectures/${lec.slug}`} class="text-xs font-bold text-[#1B365D] hover:underline whitespace-nowrap mr-4">
            التفريغ والتفاصيل ←
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
