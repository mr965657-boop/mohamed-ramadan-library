---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCategories } from '../../../lib/db';
import { verifyAdminSession } from '../../../lib/auth';

const auth = await verifyAdminSession(Astro.request, 'reader');
if (!auth.authorized) {
  return Astro.redirect('/admin/login');
}

const categories = await getCategories();
const parentCategories = categories.filter(c => !c.parent_id);
---

<AdminLayout title="إدارة التصنيفات الشجرية والأقسام">
  <div class="max-w-5xl space-y-8">
    
    <!-- بطاقة إضافة تصنيف جديد -->
    <div class="bg-white rounded-2xl border border-[#E2DCD0] p-6 shadow-sm">
      <h2 class="font-amiri font-bold text-xl text-[#143D33] mb-2 flex items-center gap-2">
        <span>📁</span>
        <span>إضافة تصنيف أو قسم فرعي جديد</span>
      </h2>
      <p class="text-xs text-[#5A6578] mb-6">
        أضف أقساماً وتصنيفات شجرية للمكتبة تنعكس فورياً في الموقع العام ومحرك البحث دون الحاجة لتعديل الكود البرمجي.
      </p>

      <form id="new-category-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              اسم التصنيف (بالعربية) <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="name_ar"
              id="cat-name-ar"
              required
              placeholder="مثال: الدراسات القرآنية"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              اسم التصنيف (English)
            </label>
            <input
              type="text"
              name="name_en"
              placeholder="e.g. Quranic Studies"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0] font-sans"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              الرابط الدائم (Slug) <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="slug"
              id="cat-slug"
              required
              placeholder="quranic-studies"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0] font-sans"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              التصنيف الأب (لإنشاء تصنيف فرعي)
            </label>
            <select name="parent_id" class="w-full px-3 py-2 text-xs rounded-lg border border-[#E2DCD0] bg-white">
              <option value="">-- تصنيف رئيسي مستقل --</option>
              {parentCategories.map(p => (
                <option value={p.id}>{p.name_ar} ({p.name_en})</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              وصف مختصر للتصنيف
            </label>
            <input
              type="text"
              name="description_ar"
              placeholder="نبذة عن طبيعة المؤلفات والدراسات التابعة لهذا التصنيف..."
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            />
          </div>
        </div>

        <div id="cat-msg" class="hidden p-3 rounded-lg text-xs font-bold"></div>

        <div class="flex justify-end pt-2">
          <button
            type="submit"
            id="cat-submit-btn"
            class="px-6 py-2.5 bg-[#143D33] hover:bg-[#1F5A4B] text-white text-xs font-bold rounded-lg transition-colors shadow"
          >
            + إضافة التصنيف
          </button>
        </div>
      </form>
    </div>

    <!-- جدول عرض التصنيفات الحالية -->
    <div class="bg-white rounded-2xl border border-[#E2DCD0] p-6 shadow-sm">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-[#E2DCD0]">
        <div>
          <h3 class="font-amiri font-bold text-lg text-[#143D33]">التصنيفات المعتمدة حالياً في المكتبة</h3>
          <p class="text-xs text-[#5A6578]">يتم استخدام هذه التصنيفات في فرز الكتب، الأبحاث، والمقالات</p>
        </div>
        <span class="px-3 py-1 bg-[#FAF7F0] text-[#143D33] font-bold text-xs rounded-lg border border-[#E2DCD0]">
          إجمالي التصنيفات: {categories.length}
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead>
            <tr class="bg-[#FAF7F0] text-[#143D33] font-bold border-b border-[#E2DCD0]">
              <th class="py-3 px-4">اسم التصنيف (عربي)</th>
              <th class="py-3 px-4">الاسم (English)</th>
              <th class="py-3 px-4">الرابط الدائم (Slug)</th>
              <th class="py-3 px-4">النوع / التبعية</th>
              <th class="py-3 px-4 text-center">إجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E2DCD0]">
            {categories.map((cat) => {
              const parent = categories.find(c => c.id === cat.parent_id);
              return (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-3 px-4 font-bold text-[#143D33]">
                    {parent ? `↳ ${cat.name_ar}` : cat.name_ar}
                  </td>
                  <td class="py-3 px-4 font-sans text-gray-700">
                    {cat.name_en}
                  </td>
                  <td class="py-3 px-4 font-mono text-[11px] text-[#B8924A]">
                    {cat.slug}
                  </td>
                  <td class="py-3 px-4">
                    {parent ? (
                      <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold border border-blue-200 text-[10px]">
                        فرعي من: {parent.name_ar}
                      </span>
                    ) : (
                      <span class="px-2 py-0.5 rounded bg-green-50 text-green-700 font-semibold border border-green-200 text-[10px]">
                        تصنيف رئيسي
                      </span>
                    )}
                  </td>
                  <td class="py-3 px-4 text-center">
                    <button
                      type="button"
                      class="delete-cat-btn text-red-600 hover:text-red-800 font-semibold"
                      data-id={cat.id}
                      data-name={cat.name_ar}
                    >
                      حذف
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  const nameArInput = document.getElementById('cat-name-ar');
  const slugInput = document.getElementById('cat-slug');
  if (nameArInput && slugInput) {
    nameArInput.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameArInput.value
          .trim()
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-') || 'category-' + Date.now();
      }
    });
    slugInput.addEventListener('input', () => {
      slugInput.dataset.manual = 'true';
    });
  }

  const form = document.getElementById('new-category-form');
  const msgBox = document.getElementById('cat-msg');
  const submitBtn = document.getElementById('cat-submit-btn');

  if (form && msgBox && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'جارٍ الحفظ...';
      msgBox.className = 'hidden';

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          msgBox.textContent = 'تمت إضافة التصنيف بنجاح!';
          msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-green-100 text-green-800 block';
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          msgBox.textContent = data.error || 'حدث خطأ أثناء حفظ التصنيف.';
          msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-red-100 text-red-800 block';
          submitBtn.disabled = false;
          submitBtn.textContent = '+ إضافة التصنيف';
        }
      } catch (err) {
        msgBox.textContent = 'تعذر الاتصال بالخادم.';
        msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-red-100 text-red-800 block';
        submitBtn.disabled = false;
        submitBtn.textContent = '+ إضافة التصنيف';
      }
    });
  }

  document.querySelectorAll('.delete-cat-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      const name = btn.dataset.name;
      if (!confirm(`هل أنت متأكد من رغبتك في حذف التصنيف "${name}"؟`)) return;

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('تعذر حذف التصنيف.');
        }
      } catch (e) {
        alert('حدث خطأ بالاتصال.');
      }
    });
  });
</script>
