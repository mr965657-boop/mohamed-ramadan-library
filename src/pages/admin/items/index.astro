---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminItems } from '../../../lib/db';
import { verifyAdminSession } from '../../../lib/auth';

const auth = await verifyAdminSession(Astro.request, 'reader');
if (!auth.authorized) {
  return Astro.redirect('/admin/login');
}

const items = await getAdminItems();

const typeLabels: Record<string, { label: string; color: string; path: string }> = {
  book: { label: '📚 الكتب والمؤلفات', color: 'bg-emerald-50 text-emerald-800 border border-emerald-200', path: 'books' },
  article: { label: '✍️ المقالات الفكرية', color: 'bg-amber-50 text-amber-800 border border-amber-200', path: 'articles' },
  research: { label: '🔬 البحوث والدراسات', color: 'bg-blue-50 text-blue-800 border border-blue-200', path: 'research' },
  lecture: { label: '🎙️ المحاضرات والدروس', color: 'bg-indigo-50 text-indigo-800 border border-indigo-200', path: 'lectures' },
  literature: { label: '📖 الأعمال الأدبية', color: 'bg-rose-50 text-rose-800 border border-rose-200', path: 'literature' },
  educational: { label: '🎓 المواد التعليمية', color: 'bg-teal-50 text-teal-800 border border-teal-200', path: 'educational' },
  project: { label: '🏛️ مشاريع بحثية', color: 'bg-purple-50 text-purple-800 border border-purple-200', path: 'research' },
};
---

<AdminLayout title="إدارة محتويات المكتبة (CRUD)">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-[#5A6578]">عرض وتعديل وحذف كافة المصنفات والمواد المنشورة أو المسودات</p>
      </div>
      <a
        href="/admin/items/new"
        class="py-2.5 px-4 bg-[#143D33] hover:bg-[#1F5A4B] text-white text-xs font-bold rounded-lg shadow transition-colors flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>إضافة عمل جديد</span>
      </a>
    </div>

    <!-- جدول إدارة المحتوى -->
    <div class="bg-white rounded-xl border border-[#E2DCD0] shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead class="bg-[#FAF7F0] border-b border-[#E2DCD0] text-[#143D33] font-bold">
            <tr>
              <th class="p-4">القسم في الموقع</th>
              <th class="p-4">العنوان</th>
              <th class="p-4">المؤلف</th>
              <th class="p-4">الحالة</th>
              <th class="p-4">المشاهدات</th>
              <th class="p-4">التحميلات</th>
              <th class="p-4 text-center">الإجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#E2DCD0]/60">
            {items.map((item) => {
              const sec = typeLabels[item.type] || { label: item.type, color: 'bg-gray-100 text-gray-800', path: 'books' };
              const publicLink = `/${sec.path}/${item.slug}`;
              return (
                <tr class="hover:bg-gray-50/80 transition-colors" id={`row-${item.id}`}>
                  <td class="p-4">
                    <span class={`px-2.5 py-1 rounded text-[11px] font-bold inline-block ${sec.color}`}>
                      {sec.label}
                    </span>
                  </td>
                  <td class="p-4 font-bold text-[#151C24] max-w-xs">
                    <div class="truncate">{item.title}</div>
                    <div class="text-[10px] text-[#5A6578] font-mono mt-0.5">{item.slug}</div>
                  </td>
                  <td class="p-4 text-[#5A6578]">{item.author}</td>
                  <td class="p-4">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold ${item.status === 'published' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}`}>
                      {item.status === 'published' ? 'منشور للزوار' : 'مسودة خاصة'}
                    </span>
                  </td>
                  <td class="p-4 font-sans font-semibold text-gray-600">{item.view_count || 0}</td>
                  <td class="p-4 font-sans font-semibold text-gray-600">{item.download_count || 0}</td>
                  <td class="p-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <a
                        href={publicLink}
                        target="_blank"
                        class="px-2.5 py-1 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 border border-emerald-200 rounded font-bold text-[11px] flex items-center gap-1 shadow-sm"
                        title="مشاهدة العمل كما يراه الزوار في الموقع العام"
                      >
                        <span>👁️</span>
                        <span>عرض في الموقع</span>
                      </a>
                      <a
                        href={`/admin/items/edit/${item.id}`}
                        class="px-2.5 py-1 bg-amber-50 text-amber-800 hover:bg-amber-100 rounded font-semibold border border-amber-200 text-[11px]"
                      >
                        تعديل ✏️
                      </a>
                      <button
                        onclick={`deleteItem('${item.id}', '${item.title}')`}
                        class="px-2.5 py-1 bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 rounded font-semibold text-[11px] cursor-pointer"
                      >
                        حذف نهائي 🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  async function deleteItem(id, title) {
    if (!confirm(`هل أنت متأكد من حذف العمل: "${title}"؟`)) {
      return;
    }
    try {
      const res = await fetch('/api/admin/items', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id }),
      });
      const data = await res.json();
      if (data.success) {
        const row = document.getElementById(`row-${id}`);
        if (row) row.remove();
        alert('تم حذف العمل بنجاح.');
      } else {
        alert('حدث خطأ أثناء الحذف.');
      }
    } catch (e) {
      alert('تعذر الاتصال بالخادم.');
    }
  }
</script>
