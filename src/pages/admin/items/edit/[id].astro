---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getItemById, getCategories } from '../../../../lib/db';

const { id } = Astro.params;
const item = await getItemById(id as string);
const categories = await getCategories();

if (!item) {
  return Astro.redirect('/admin/items');
}
---

<AdminLayout title={`تعديل: ${item.title}`}>
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="bg-white rounded-2xl border border-[#E2DCD0] p-6 sm:p-8 shadow-sm">
      
      <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#E2DCD0]">
        <div>
          <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">تعديل عمل حالي</span>
          <h2 class="font-amiri font-bold text-2xl text-[#143D33] mt-1">{item.title}</h2>
        </div>
        <a href="/admin/items" class="text-xs font-bold text-[#1B365D] hover:underline">
          ← العودة لقائمة المحتويات
        </a>
      </div>

      <form id="edit-item-form" class="space-y-6">
        <input type="hidden" name="id" value={item.id} />
        
        <!-- نوع المحتوى واللغة والتصنيف -->
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              نوع العمل <span class="text-red-500">*</span>
            </label>
            <select name="type" id="type-select" required class="w-full px-3 py-2 text-xs rounded-lg border border-[#E2DCD0] bg-white focus:ring-2 focus:ring-[#143D33]">
              <option value="book" selected={item.type === 'book'}>كتاب ومؤلف</option>
              <option value="research" selected={item.type === 'research'}>بحث ودراسة أكاديمية</option>
              <option value="project" selected={item.type === 'project'}>مشروع بحثي متكامل</option>
              <option value="article" selected={item.type === 'article'}>مقال فكري</option>
              <option value="lecture" selected={item.type === 'lecture'}>محاضرة ودرس صوتي</option>
              <option value="literature" selected={item.type === 'literature'}>عمل أدبي</option>
              <option value="educational" selected={item.type === 'educational'}>مادة تعليمية</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">التصنيف الموضوعي</label>
            <select name="category_id" class="w-full px-3 py-2 text-xs rounded-lg border border-[#E2DCD0] bg-white">
              <option value="">-- اختر التصنيف --</option>
              {categories.map((c) => (
                <option value={c.id} selected={item.category_id === c.id}>{c.name_ar} ({c.name_en})</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">لغة المحتوى</label>
            <select name="language" class="w-full px-3 py-2 text-xs rounded-lg border border-[#E2DCD0] bg-white">
              <option value="ar" selected={item.language === 'ar'}>العربية (RTL)</option>
              <option value="en" selected={item.language === 'en'}>English (LTR)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">حالة النشر</label>
            <select name="status" class="w-full px-3 py-2 text-xs rounded-lg border border-[#E2DCD0] bg-white">
              <option value="published" selected={item.status === 'published'}>منشور فوراً</option>
              <option value="draft" selected={item.status === 'draft'}>حفظ كمسودة</option>
              <option value="archived" selected={item.status === 'archived'}>مؤرشف</option>
            </select>
          </div>
        </div>

        <!-- العنوان والرابط الدائم والكاتب -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              عنوان العمل <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="title"
              required
              value={item.title}
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              الرابط الدائم (Slug) <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="slug"
              required
              value={item.slug}
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0] font-sans"
            />
          </div>
        </div>

        <!-- الكاتب ورابط الغلاف -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">اسم المؤلف / الباحث</label>
            <input
              type="text"
              name="author"
              value={item.author}
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">صورة الغلاف</label>
            <input
              type="text"
              name="cover_image_url"
              value={item.cover_image_url || ''}
              placeholder="https://example.com/cover.jpg أو ارفع صورة من جهازك"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0] font-sans"
            />
            <div class="mt-1.5 flex items-center gap-2">
              <input type="file" id="cover-file-input" accept="image/*" class="hidden" />
              <button
                type="button"
                onclick="document.getElementById('cover-file-input').click()"
                class="px-2.5 py-1 text-[11px] bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold rounded border border-gray-300 transition-colors cursor-pointer"
              >
                📁 رفع صورة من جهازك
              </button>
              <span id="cover-upload-status" class="text-[11px] text-[#5A6578]"></span>
            </div>
            <div id="cover-preview-container" class={`mt-2 ${item.cover_image_url ? '' : 'hidden'}`}>
              <img id="cover-preview-img" src={item.cover_image_url || ''} alt="معاينة الغلاف" class="w-20 h-28 object-cover rounded-md border border-[#E2DCD0] shadow-sm" />
            </div>
          </div>
        </div>

        <!-- قسم التوثيق والبيانات الأكاديمية (Academic Metadata) -->
        <div class="p-4 rounded-xl border border-[#B8924A]/40 bg-[#FAF7F0] space-y-4">
          <h3 class="font-amiri font-bold text-sm text-[#143D33] flex items-center gap-1.5">
            <span>🎓</span>
            <span>البيانات الأكاديمية والتوثيق المرجعي (اختياري للأبحاث والكتب)</span>
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-[#143D33] mb-1">جهة النشر / الدورية</label>
              <input
                type="text"
                name="journal_or_publisher"
                value={item.journal_or_publisher || ''}
                placeholder="مجلة الدراسات التراثية"
                class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#E2DCD0] bg-white"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-[#143D33] mb-1">المعرف الرقمي (DOI)</label>
              <input
                type="text"
                name="doi"
                value={item.doi || ''}
                placeholder="10.1000/182.library.2026.01"
                class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#E2DCD0] bg-white font-mono"
              />
            </div>

            <div class="grid grid-cols-3 gap-1">
              <div>
                <label class="block text-[10px] font-bold text-[#143D33] mb-1">المجلد</label>
                <input type="text" name="volume" value={item.volume || ''} placeholder="14" class="w-full px-2 py-1.5 text-xs rounded border border-[#E2DCD0] bg-white font-sans text-center" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[#143D33] mb-1">العدد</label>
                <input type="text" name="issue" value={item.issue || ''} placeholder="2" class="w-full px-2 py-1.5 text-xs rounded border border-[#E2DCD0] bg-white font-sans text-center" />
              </div>
              <div>
                <label class="block text-[10px] font-bold text-[#143D33] mb-1">الصفحات</label>
                <input type="text" name="pages_range" value={item.pages_range || ''} placeholder="45-72" class="w-full px-2 py-1.5 text-xs rounded border border-[#E2DCD0] bg-white font-sans text-center" />
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-6 pt-1 text-xs">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="peer_reviewed" value="true" checked={item.peer_reviewed} class="rounded text-[#143D33]" />
              <span class="font-bold text-[#143D33]">بحث محكّم علمياً (Peer-Reviewed)</span>
            </label>

            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="is_demo" value="true" checked={item.is_demo} class="rounded text-[#143D33]" />
              <span class="text-amber-800 font-semibold">تمييز كـ "محتوى تجريبي استرشادي"</span>
            </label>
          </div>
        </div>

        <!-- ملف PDF أو ملف الصوت MP3 وعدد الصفحات -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">
              ملف الـ PDF أو المادة الرقمية
            </label>
            <input
              type="text"
              name="file_url"
              value={item.file_url || ''}
              placeholder="https://example.com/file.pdf أو ارفع ملف الـ PDF من جهازك مباشرة"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0] font-sans"
            />
            <div class="mt-1.5 flex items-center gap-2">
              <input type="file" id="pdf-file-input" accept=".pdf,application/pdf" class="hidden" />
              <button
                type="button"
                onclick="document.getElementById('pdf-file-input').click()"
                class="px-2.5 py-1 text-[11px] bg-[#1B365D] hover:bg-[#254677] text-white font-bold rounded shadow-sm flex items-center gap-1 transition-colors cursor-pointer"
              >
                <span>📄</span>
                <span>رفع ملف PDF من جهازك</span>
              </button>
              <span id="pdf-upload-status" class="text-[11px] text-[#5A6578]"></span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">عدد الصفحات / الدقائق</label>
            <input
              type="number"
              name="page_count"
              value={item.page_count || ''}
              placeholder="مثال: 120"
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            />
          </div>
        </div>

        <!-- ملخص البحث (Abstract) والنبذة -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">النبذة المختصرة (Excerpt)</label>
            <textarea
              name="excerpt"
              rows="3"
              placeholder="ملخص موجز للمحتوى..."
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            >{item.excerpt || ''}</textarea>
          </div>

          <div>
            <label class="block text-xs font-bold text-[#143D33] mb-1.5">ملخص البحث الأكاديمي (Abstract)</label>
            <textarea
              name="abstract"
              rows="3"
              placeholder="ملخص الدراسة الرسمي..."
              class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
            >{item.abstract || ''}</textarea>
          </div>
        </div>

        <!-- المحرر المرئي التفاعلي المباشر (Visual Live WYSIWYG Editor) -->
        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <label class="block text-xs font-bold text-[#143D33] flex items-center gap-1.5">
              <span>✍️</span>
              <span>محرر المقال التفاعلي المباشر (اكتب أو الصق وسيتم التنسيق البصري فوراً)</span>
            </label>
            <div class="flex items-center gap-2">
              <span id="editor-auto-badge" class="px-2.5 py-0.5 rounded-full text-[11px] bg-green-100 text-green-800 font-bold border border-green-200">
                ⚡ التنسيق التلقائي عند اللصق مفعّل
              </span>
              <button
                type="button"
                id="btn-auto-excerpt"
                class="px-2.5 py-1 bg-white hover:bg-gray-100 text-[#143D33] text-[11px] font-bold rounded-lg border border-[#E2DCD0] flex items-center gap-1 transition-all cursor-pointer shadow-sm"
                title="استخراج النبذة والملخص تلقائياً من المقال"
              >
                <span>⚡</span>
                <span>توليد نبذة تلقائية</span>
              </button>
            </div>
          </div>

          <!-- شريط أدوات التنسيق البصري الفوري (Visual Toolbar) -->
          <div class="flex flex-wrap items-center justify-between gap-1.5 p-2 bg-[#FAF7F0] border border-[#E2DCD0] rounded-t-xl text-xs select-none">
            <div class="flex flex-wrap items-center gap-1">
              <button
                type="button"
                id="btn-auto-format"
                class="px-3 py-1 bg-gradient-to-r from-[#B8924A] to-[#8F6B27] hover:from-[#A5803B] hover:to-[#7E5D1E] text-white text-xs font-bold rounded-lg shadow-sm flex items-center gap-1 cursor-pointer"
                title="إعادة تنسيق كل النص داخل المربع وتحويل العناوين والاقتباسات تلقائياً"
              >
                <span>✨</span>
                <span>تنسيق المقال بالكامل تلقائياً</span>
              </button>

              <div class="h-4 w-[1px] bg-gray-300 mx-1"></div>

              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-emerald-50 text-[#143D33] border border-gray-200 rounded font-bold text-xs" data-command="h2" title="تحويل السطر إلى عنوان رئيسي فخم مع شريط مذهب">
                H2 عنوان رئيسي
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-blue-50 text-[#1B365D] border border-gray-200 rounded font-bold text-xs" data-command="h3" title="تحويل السطر إلى عنوان فرعي">
                H3 عنوان فرعي
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-gray-50 border border-gray-200 rounded text-xs" data-command="p" title="نص فقرة عادية">
                فقرة عادية
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-gray-50 border border-gray-200 rounded font-bold text-xs" data-command="bold" title="خط عريض">
                <b>B عريض</b>
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-amber-50 text-amber-900 border border-gray-200 rounded text-xs" data-command="quote" title="صندوق اقتباس تراثي مذهب">
                ❝ صندوق اقتباس
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-gray-50 border border-gray-200 rounded text-xs" data-command="ul" title="قائمة نقطية">
                • قائمة نقطية
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-gray-50 border border-gray-200 rounded text-xs" data-command="ol" title="قائمة رقمية">
                1. مرقمة
              </button>
              <button type="button" class="tool-btn px-2.5 py-1 bg-white hover:bg-gray-50 border border-gray-200 rounded text-xs" data-command="divider" title="خط فاصل مذهب">
                ⚜️ فاصل
              </button>
            </div>

            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="btn-toggle-code"
                class="px-2.5 py-1 bg-white hover:bg-gray-100 border border-gray-200 rounded text-[11px] font-mono text-gray-600 cursor-pointer"
                title="عرض أو تعديل كود HTML المباشر"
              >
                &lt;/&gt; كود
              </button>
              <button
                type="button"
                class="tool-btn px-2 py-1 bg-white hover:bg-red-50 text-red-600 border border-gray-200 rounded text-xs cursor-pointer"
                data-command="clean"
                title="مسح كافة التنسيقات والعودة لنص خام"
              >
                🧹 تنظيف
              </button>
            </div>
          </div>

          <!-- مساحة التحرير المرئي المباشر (WYSIWYG) -->
          <div
            id="visual-editor"
            contenteditable="true"
            class="academic-reader-content min-h-[380px] max-h-[700px] overflow-y-auto p-6 sm:p-8 bg-white border-x border-b border-[#E2DCD0] rounded-b-xl focus:outline-none focus:ring-2 focus:ring-[#143D33]/20 shadow-inner"
            placeholder="اكتب أو الصق المقال هنا مباشرة..."
            set:html={item.content || ''}
          ></div>

          <!-- مساحة كود HTML البديلة (مخفية وتظهر عند الضغط على زر الكود) -->
          <textarea
            id="code-editor"
            class="hidden w-full min-h-[380px] p-4 font-mono text-xs text-gray-800 bg-gray-50 border-x border-b border-[#E2DCD0] rounded-b-xl focus:outline-none leading-relaxed"
          >{item.content || ''}</textarea>

          <!-- حقل النموذج الحقيقي الذي يُرسل إلى الخادم -->
          <input type="hidden" id="content-input" name="content" value={item.content || ''} />
        </div>

        <!-- الكلمات الدلالية والوسوم -->
        <div>
          <label class="block text-xs font-bold text-[#143D33] mb-1.5">الوسوم والكلمات الدلالية (مفصولة بفاصلة)</label>
          <input
            type="text"
            name="tags"
            value={item.tags ? item.tags.join(', ') : ''}
            placeholder="تراث, تحقيق, مخطوطات"
            class="w-full px-3.5 py-2 text-xs rounded-lg border border-[#E2DCD0]"
          />
        </div>

        <div id="form-msg" class="hidden p-3 rounded-lg text-xs font-bold"></div>

        <!-- زر الحفظ -->
        <div class="flex justify-end gap-3 pt-4 border-t border-[#E2DCD0]">
          <a href="/admin/items" class="py-2.5 px-5 text-xs font-semibold rounded-lg border border-gray-300 hover:bg-gray-50">
            إلغاء
          </a>
          <button
            type="submit"
            id="save-btn"
            class="py-2.5 px-6 bg-[#143D33] hover:bg-[#1F5A4B] text-white text-xs font-bold rounded-lg shadow transition-colors"
          >
            حفظ التعديلات
          </button>
        </div>

      </form>

    </div>
  </div>
</AdminLayout>

<script is:inline>
  function formatDoc(tag) {
    const textarea = document.getElementById('content-area');
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const selectedText = textarea.value.substring(start, end) || 'النص هنا';
    let replacement = '';
    if (tag === 'h2') replacement = `<h2>${selectedText}</h2>\n`;
    else if (tag === 'h3') replacement = `<h3>${selectedText}</h3>\n`;
    else if (tag === 'bold') replacement = `<strong>${selectedText}</strong>`;
    else if (tag === 'quote') replacement = `<blockquote>${selectedText}</blockquote>\n`;
    else replacement = `<p>${selectedText}</p>\n`;

    textarea.value = textarea.value.substring(0, start) + replacement + textarea.value.substring(end);
  }

  const coverFileInput = document.getElementById('cover-file-input');
  const coverUrlInput = document.querySelector('input[name="cover_image_url"]');
  const coverStatus = document.getElementById('cover-upload-status');
  // ضغط الصور وتحسين حجمها في المتصفح قبل الرفع
  function resizeAndCompressImage(file, maxWidth = 1600, quality = 0.85) {
    return new Promise((resolve) => {
      if (!file.type.startsWith('image/') || file.type === 'image/svg+xml' || file.type === 'image/gif') {
        return resolve(file);
      }
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          let { width, height } = img;
          if (width > maxWidth || height > maxWidth) {
            if (width > height) {
              height = Math.round((height * maxWidth) / width);
              width = maxWidth;
            } else {
              width = Math.round((width * maxWidth) / height);
              height = maxWidth;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          canvas.toBlob((blob) => {
            if (blob && blob.size < file.size) {
              resolve(new File([blob], file.name.replace(/\.[^.]+$/, '.jpg'), { type: 'image/jpeg' }));
            } else {
              resolve(file);
            }
          }, 'image/jpeg', quality);
        };
        img.onerror = () => resolve(file);
        img.src = e.target.result;
      };
      reader.onerror = () => resolve(file);
      reader.readAsDataURL(file);
    });
  }

  // دالة رفع الملفات إلى التخزين السحابي مع حلول احتياطية متعددة
  async function uploadFileDirect(file) {
    const cleanBaseName = file.name.replace(/[^\w.-]/g, '_').replace(/^_+/, '') || 'upload';
    const fileName = `${Date.now()}-${cleanBaseName}`;
    const supabaseUrl = 'https://tbdjgisqbkccefodvbwq.supabase.co';
    const apiKey = 'sb_publishable_pCtFWYDkfdtkkQ6mQ6ndUQ_mhrRILDF';
    
    // 1. محاولة الرفع المباشر إلى Supabase Storage
    try {
      const uploadRes = await fetch(`${supabaseUrl}/storage/v1/object/library-media/${fileName}`, {
        method: 'POST',
        headers: {
          'apikey': apiKey,
          'Authorization': `Bearer ${apiKey}`,
          'Content-Type': file.type || 'application/octet-stream',
          'x-upsert': 'true'
        },
        body: file
      });
      if (uploadRes.ok) {
        return `${supabaseUrl}/storage/v1/object/public/library-media/${fileName}`;
      }
    } catch (e) {
      console.warn('Direct storage upload failed, falling back to server route');
    }

    // 2. محاولة الرفع عبر الخادم
    try {
      const fd = new FormData();
      fd.append('file', file);
      const serverRes = await fetch('/api/admin/upload', { method: 'POST', body: fd });
      const data = await serverRes.json();
      if (serverRes.ok && data.url) return data.url;
    } catch (e) {
      console.warn('Server upload error, falling back to local data URL', e);
    }

    // 3. حل احتياطي فوري للصور يضمن عدم الفشل نهائياً
    if (file.type.startsWith('image/')) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.readAsDataURL(file);
      });
    }

    throw new Error('تعذر رفع الملف، يرجى المحاولة مرة أخرى أو التأكد من اتصال الإنترنت');
  }

  // معالجة رفع صورة الغلاف مع المعاينة الفورية
  const coverFileInput = document.getElementById('cover-file-input');
  const coverUrlInput = document.querySelector('input[name="cover_image_url"]');
  const coverStatus = document.getElementById('cover-upload-status');
  const coverPreviewContainer = document.getElementById('cover-preview-container');
  const coverPreviewImg = document.getElementById('cover-preview-img');

  if (coverFileInput && coverUrlInput) {
    coverFileInput.addEventListener('change', async () => {
      let file = coverFileInput.files[0];
      if (!file) return;
      if (coverStatus) {
        coverStatus.textContent = 'جارٍ تحسين الصورة ورفعها...';
        coverStatus.className = 'text-[11px] font-bold text-[#B8924A] animate-pulse';
      }
      try {
        file = await resizeAndCompressImage(file);
        const url = await uploadFileDirect(file);
        coverUrlInput.value = url;
        if (coverPreviewContainer && coverPreviewImg) {
          coverPreviewImg.src = url;
          coverPreviewContainer.classList.remove('hidden');
        }
        if (coverStatus) {
          coverStatus.textContent = '✓ تم رفع الصورة بنجاح!';
          coverStatus.className = 'text-[11px] font-bold text-green-700';
        }
      } catch (err) {
        if (coverStatus) {
          coverStatus.textContent = err.message || 'فشل الرفع';
          coverStatus.className = 'text-[11px] font-bold text-red-600';
        }
      }
    });
  }

  // معالجة رفع ملف PDF
  const pdfFileInput = document.getElementById('pdf-file-input');
  const pdfUrlInput = document.querySelector('input[name="file_url"]');
  const pdfStatus = document.getElementById('pdf-upload-status');
  if (pdfFileInput && pdfUrlInput) {
    pdfFileInput.addEventListener('change', async () => {
      const file = pdfFileInput.files[0];
      if (!file) return;
      const sizeMB = (file.size / (1024 * 1024)).toFixed(1);
      if (pdfStatus) {
        pdfStatus.textContent = `جارٍ رفع ملف الـ PDF (${sizeMB} MB)...`;
        pdfStatus.className = 'text-[11px] font-bold text-[#B8924A] animate-pulse';
      }
      try {
        const url = await uploadFileDirect(file);
        pdfUrlInput.value = url;
        if (pdfStatus) {
          pdfStatus.textContent = `✓ تم رفع ملف الـ PDF بنجاح (${file.name})!`;
          pdfStatus.className = 'text-[11px] font-bold text-green-700';
        }
      } catch (err) {
        if (pdfStatus) {
          pdfStatus.textContent = err.message || 'فشل رفع الملف';
          pdfStatus.className = 'text-[11px] font-bold text-red-600';
        }
      }
    });
  }

  // 1. محرك التنسيق التلقائي الذكي للمقالات والأبحاث
  function autoFormatArticle(rawText) {
    if (!rawText || !rawText.trim()) return '';

    let clean = rawText
      .replace(/<!--[\s\S]*?-->/g, '')
      .replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<script[\s\S]*?<\/script>/gi, '');

    // إذا كان كود HTML منسوخ من Word، يتم تطهيره
    if (/<[a-z][\s\S]*>/i.test(clean)) {
      clean = clean
        .replace(/<(\/?)span[^>]*>/gi, '')
        .replace(/class="Mso[^"]*"/gi, '')
        .replace(/style="[^"]*"/gi, '')
        .replace(/<o:p>[\s\S]*?<\/o:p>/gi, '')
        .replace(/<font[^>]*>/gi, '')
        .replace(/<\/font>/gi, '');
      
      if (/<(p|h2|h3|h4|blockquote|ul|ol|li)[^>]*>/i.test(clean)) {
        return clean.trim();
      }
    }

    const lines = clean.split(/\r?\n/).map(l => l.trim());
    const output = [];
    let currentList = [];
    let isOrderedList = false;

    function flushList() {
      if (currentList.length > 0) {
        const tag = isOrderedList ? 'ol' : 'ul';
        const cls = isOrderedList 
          ? 'list-decimal pr-6 space-y-1.5 my-3 text-sm text-[#2C3E50]' 
          : 'list-disc pr-6 space-y-1.5 my-3 text-sm text-[#2C3E50]';
        output.push(`<${tag} class="${cls}">` + currentList.map(li => `<li>${li}</li>`).join('') + `</${tag}>`);
        currentList = [];
      }
    }

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      if (!line) {
        flushList();
        continue;
      }

      // 1. عناوين ماركداون (# / ## / ###)
      if (line.startsWith('### ')) {
        flushList();
        output.push(`<h3 class="text-xl font-bold font-amiri text-[#1B365D] mt-8 mb-3">${line.slice(4).trim()}</h3>`);
        continue;
      }
      if (line.startsWith('## ') || line.startsWith('# ')) {
        flushList();
        const content = line.replace(/^#+\s*/, '').trim();
        output.push(`<h2 class="text-2xl font-bold font-amiri text-[#143D33] mt-10 mb-4 border-r-4 border-[#B8924A] pr-3.5 leading-snug">${content}</h2>`);
        continue;
      }

      // 2. عناوين الأقسام والفصول الأكاديمية والمداخل
      const arabicHeadingRegex = /^(الافتتاحية|المدخل|المقدمة|التمهيد|المبحث|المطلب|الفصل|الباب|المحور|طرح الإشكال|الإشكالية|الخاتمة|النتائج|التوصيات|الخلاصة|المراجع|ثبت المصادر|أولاً|ثانياً|ثالثاً|رابعاً|خامساً|سادساً|سابعاً|ثامناً|تاسعاً|عاشراً)\s*[:\-\.]?\s*(.*)$/i;
      const headingMatch = line.match(arabicHeadingRegex);
      if (headingMatch && line.length < 110) {
        flushList();
        output.push(`<h2 class="text-2xl font-bold font-amiri text-[#143D33] mt-10 mb-4 border-r-4 border-[#B8924A] pr-3.5 leading-snug">${line}</h2>`);
        continue;
      }

      // 3. السطور القصيرة المستقلة التي تمثل عناوين فرعية (أقل من 70 حرفاً وتنتهي بـ : أو ؟ أو ! أو بدون نقطة)
      const isShortHeadingCandidate = 
        line.length > 3 && 
        line.length < 75 && 
        (line.endsWith(':') || line.endsWith('؟') || line.endsWith('!') || (!line.endsWith('.') && !line.includes('،')));

      if (isShortHeadingCandidate && (i === 0 || !lines[i - 1] || !lines[i + 1])) {
        flushList();
        if (i === 0) {
          output.push(`<h2 class="text-2xl sm:text-3xl font-bold font-amiri text-[#143D33] mt-4 mb-6 border-r-4 border-[#B8924A] pr-3.5 leading-snug">${line}</h2>`);
        } else {
          output.push(`<h3 class="text-xl font-bold font-amiri text-[#1B365D] mt-8 mb-3 pr-2">${line}</h3>`);
        }
        continue;
      }

      // 4. الاقتباسات والأحاديث والآيات فقط (قصيرة ومحددة بدقة)
      if (
        line.startsWith('>') || 
        /^(قال تعالى|قال رسول الله|روي عن|جاء في الأثر|يقول الإمام)\s*[:\-]/i.test(line) ||
        (line.startsWith('«') && line.endsWith('»') && line.length < 250)
      ) {
        flushList();
        const quoteText = line.replace(/^>\s*/, '').replace(/^[«"]|[»"]$/g, '').trim();
        output.push(`<blockquote class="border-r-4 border-[#B8924A] bg-[#FAF7F0] p-5 my-6 rounded-l font-amiri text-lg text-[#1B365D] leading-relaxed shadow-sm not-italic">${quoteText}</blockquote>`);
        continue;
      }

      // 5. قوائم نقطية
      if (/^[\-\*•—]\s+/.test(line)) {
        if (currentList.length > 0 && isOrderedList) flushList();
        isOrderedList = false;
        currentList.push(line.replace(/^[\-\*•—]\s+/, '').trim());
        continue;
      }

      // 6. قوائم رقمية
      if (/^\d+[\.\-\)]\s+/.test(line)) {
        if (currentList.length > 0 && !isOrderedList) flushList();
        isOrderedList = true;
        currentList.push(line.replace(/^\d+[\.\-\)]\s+/, '').trim());
        continue;
      }

      // 7. فقرة نصية عادية مريحة ومتناسقة
      flushList();
      output.push(`<p class="leading-[2.2] mb-6 text-[#1E293B] text-[18px] font-naskh">${line}</p>`);
    }

    flushList();
    return output.join('\n');
  }

  // 2. ربط المحرر المرئي التفاعلي المباشر (Visual Live Editor)
  const visualEditor = document.getElementById('visual-editor');
  const codeEditor = document.getElementById('code-editor');
  const contentInput = document.getElementById('content-input');
  const btnAutoFormat = document.getElementById('btn-auto-format');
  const btnAutoExcerpt = document.getElementById('btn-auto-excerpt');
  const btnToggleCode = document.getElementById('btn-toggle-code');
  let isCodeView = false;

  function syncContent() {
    if (isCodeView && codeEditor) {
      if (contentInput) contentInput.value = codeEditor.value;
      if (visualEditor) visualEditor.innerHTML = codeEditor.value;
    } else if (visualEditor) {
      if (contentInput) contentInput.value = visualEditor.innerHTML;
      if (codeEditor) codeEditor.value = visualEditor.innerHTML;
    }
  }

  if (visualEditor) {
    visualEditor.addEventListener('input', syncContent);

    // سحر التنسيق التلقائي اللحظي عند اللصق
    visualEditor.addEventListener('paste', (e) => {
      e.preventDefault();
      const text = e.clipboardData.getData('text/plain');
      if (!text || !text.trim()) return;

      const formatted = autoFormatArticle(text);
      document.execCommand('insertHTML', false, formatted);
      syncContent();

      const badge = document.getElementById('editor-auto-badge');
      if (badge) {
        badge.textContent = '✨ تم تنسيق النص الملصوق آلياً وبأعلى معايير الراحة!';
        badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] bg-emerald-600 text-white font-bold shadow animate-pulse';
        setTimeout(() => {
          badge.textContent = '⚡ التنسيق التلقائي عند اللصق مفعّل';
          badge.className = 'px-2.5 py-0.5 rounded-full text-[11px] bg-green-100 text-green-800 font-bold border border-green-200';
        }, 3500);
      }
    });
  }

  if (codeEditor) {
    codeEditor.addEventListener('input', syncContent);
  }

  // زر تنسيق المقال بالكامل تلقائياً
  if (btnAutoFormat && visualEditor) {
    btnAutoFormat.addEventListener('click', () => {
      const rawText = visualEditor.innerText || visualEditor.textContent || '';
      if (!rawText.trim()) {
        alert('يرجى كتابة أو لصق نص المقال أولاً في المربع!');
        return;
      }
      visualEditor.innerHTML = autoFormatArticle(rawText);
      syncContent();

      btnAutoFormat.classList.add('bg-green-700');
      btnAutoFormat.innerHTML = '<span>✓</span> <span>تم التنسيق البصري بنجاح!</span>';
      setTimeout(() => {
        btnAutoFormat.classList.remove('bg-green-700');
        btnAutoFormat.innerHTML = '<span>✨</span> <span>تنسيق المقال بالكامل تلقائياً</span>';
      }, 2000);
    });
  }

  // زر التبديل لكود HTML المباشر
  if (btnToggleCode && visualEditor && codeEditor) {
    btnToggleCode.addEventListener('click', () => {
      isCodeView = !isCodeView;
      if (isCodeView) {
        codeEditor.value = visualEditor.innerHTML;
        visualEditor.classList.add('hidden');
        codeEditor.classList.remove('hidden');
        btnToggleCode.textContent = '👁️ العودة للمحرر المرئي';
        btnToggleCode.classList.add('bg-[#143D33]', 'text-white');
      } else {
        visualEditor.innerHTML = codeEditor.value;
        codeEditor.classList.add('hidden');
        visualEditor.classList.remove('hidden');
        btnToggleCode.textContent = '</> كود';
        btnToggleCode.classList.remove('bg-[#143D33]', 'text-white');
      }
      syncContent();
    });
  }

  // توليد نبذة تلقائية
  if (btnAutoExcerpt && visualEditor) {
    btnAutoExcerpt.addEventListener('click', () => {
      const textOnly = (visualEditor.innerText || visualEditor.textContent || '').replace(/\s+/g, ' ').trim();
      if (!textOnly) {
        alert('يرجى كتابة أو لصق المقال أولاً لاستخراج النبذة منه!');
        return;
      }
      const firstChunk = textOnly.slice(0, 240);
      const lastDot = firstChunk.lastIndexOf('.');
      const cleanSummary = (lastDot > 80 ? firstChunk.slice(0, lastDot + 1) : firstChunk) + '...';

      const excerptInput = document.querySelector('textarea[name="excerpt"]');
      const abstractInput = document.querySelector('textarea[name="abstract"]');
      if (excerptInput && !excerptInput.value.trim()) excerptInput.value = cleanSummary;
      if (abstractInput && !abstractInput.value.trim()) abstractInput.value = cleanSummary;

      btnAutoExcerpt.innerHTML = '<span>✓</span> <span>تم توليد النبذة!</span>';
      setTimeout(() => {
        btnAutoExcerpt.innerHTML = '<span>⚡</span> <span>توليد نبذة تلقائية</span>';
      }, 2000);
    });
  }

  // أزرار شريط الأدوات المرئية (Visual Tools)
  document.querySelectorAll('.tool-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!visualEditor) return;
      visualEditor.focus();
      const cmd = btn.getAttribute('data-command');

      if (cmd === 'bold') {
        document.execCommand('bold', false, null);
      } else if (cmd === 'ul') {
        document.execCommand('insertUnorderedList', false, null);
      } else if (cmd === 'ol') {
        document.execCommand('insertOrderedList', false, null);
      } else if (cmd === 'divider') {
        document.execCommand('insertHTML', false, '<hr class="my-8 border-t-2 border-dashed border-[#B8924A]/40" />');
      } else if (cmd === 'clean') {
        const plain = visualEditor.innerText || visualEditor.textContent || '';
        visualEditor.innerText = plain;
      } else if (cmd === 'h2' || cmd === 'h3' || cmd === 'p' || cmd === 'quote') {
        const sel = window.getSelection();
        let selectedText = sel ? sel.toString().trim() : '';
        if (!selectedText) selectedText = 'عنوان جديد';

        let replacement = '';
        if (cmd === 'h2') {
          replacement = `<h2 class="text-2xl font-bold font-amiri text-[#143D33] mt-10 mb-4 border-r-4 border-[#B8924A] pr-3.5 leading-snug">${selectedText}</h2>`;
        } else if (cmd === 'h3') {
          replacement = `<h3 class="text-xl font-bold font-amiri text-[#1B365D] mt-8 mb-3 pr-2">${selectedText}</h3>`;
        } else if (cmd === 'p') {
          replacement = `<p class="leading-[2.2] mb-6 text-[#1E293B] text-[18px] font-naskh">${selectedText}</p>`;
        } else if (cmd === 'quote') {
          replacement = `<blockquote class="border-r-4 border-[#B8924A] bg-[#FAF7F0] p-5 my-6 rounded-l font-amiri text-lg text-[#1B365D] leading-relaxed shadow-sm not-italic">${selectedText}</blockquote>`;
        }
        document.execCommand('insertHTML', false, replacement);
      }

      syncContent();
    });
  });

  const form = document.getElementById('edit-item-form');
  const msgBox = document.getElementById('form-msg');
  const saveBtn = document.getElementById('save-btn');

  if (form && msgBox && saveBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.textContent = 'جارٍ حفظ التعديلات...';
      msgBox.className = 'hidden';

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/admin/items', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          msgBox.textContent = 'تم حفظ التعديلات بنجاح! جارٍ التحويل...';
          msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-green-100 text-green-800 block';
          setTimeout(() => {
            window.location.href = '/admin/items';
          }, 800);
        } else {
          msgBox.textContent = data.error || 'حدث خطأ أثناء تعديل العمل.';
          msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-red-100 text-red-800 block';
          saveBtn.disabled = false;
          saveBtn.textContent = 'حفظ التعديلات';
        }
      } catch (err) {
        msgBox.textContent = 'تعذر الاتصال بالخادم.';
        msgBox.className = 'p-3 rounded-lg text-xs font-bold bg-red-100 text-red-800 block';
        saveBtn.disabled = false;
        saveBtn.textContent = 'حفظ التعديلات';
      }
    });
  }
</script>
