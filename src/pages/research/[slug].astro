---
import Layout from '../../layouts/Layout.astro';
import { getItemBySlug } from '../../lib/db';
import { generateAllCitations } from '../../lib/citation';
import { useTranslations, type Language } from '../../lib/i18n';

const { slug } = Astro.params;
const url = new URL(Astro.request.url);
const lang = (url.searchParams.get('lang') as Language) || 'ar';
const t = useTranslations(lang);

const item = await getItemBySlug(slug as string, lang);

if (!item || (item.type !== 'research' && item.type !== 'project')) {
  return Astro.redirect(lang === 'en' ? '/research?lang=en' : '/research');
}

const siteUrl = Astro.url.origin;
const citations = generateAllCitations(item, siteUrl);
const isRTL = lang === 'ar';
const isProject = item.type === 'project';
---

<Layout
  title={item.title}
  description={item.excerpt || item.title}
  type="article"
  lang={lang}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    
    <!-- مسار التنقل (Breadcrumb) -->
    <nav class="text-xs text-[#5A6578] mb-6 flex items-center gap-2 flex-wrap">
      <a href={lang === 'en' ? '/?lang=en' : '/'} class="hover:underline">{t.home}</a>
      <span>/</span>
      <a href={lang === 'en' ? '/research?lang=en' : '/research'} class="hover:underline">
        {isProject ? (isRTL ? 'المشاريع البحثية' : 'Research Projects') : t.research}
      </a>
      <span>/</span>
      <span class="text-[#1B365D] font-semibold truncate max-w-xs">{item.title}</span>
    </nav>

    <!-- رأس الورقة البحثية -->
    <header class="mb-8 pb-6 border-b border-[#E2DCD0] dark:border-[#2B384E]">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-1 text-xs font-bold rounded bg-[#1B365D] text-white tracking-wider">
          {isProject 
            ? (isRTL ? 'مشروع بحثي متكامل' : 'Research Project') 
            : (isRTL ? 'ورقة بحثية محكمة' : 'Peer-Reviewed Research')}
        </span>

        {item.peer_reviewed && (
          <span class="px-2.5 py-1 text-xs font-semibold rounded bg-green-50 text-green-800 border border-green-200 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{isRTL ? 'محكّم علمياً' : 'Peer Reviewed'}</span>
          </span>
        )}

        {item.is_demo && (
          <span class="px-2.5 py-1 text-xs font-semibold rounded bg-amber-50 text-amber-800 border border-amber-300">
            {isRTL ? 'محتوى تجريبي استرشادي' : 'Demo Content'}
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] leading-snug">
        {item.title}
      </h1>

      <!-- بيانات الباحث وتاريخ النشر والوعاء العلمي -->
      <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-[#5A6578] dark:text-gray-400 mt-4 pt-2">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#B8924A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>{isRTL ? 'الباحث:' : 'Author:'} <strong class="text-[#143D33] dark:text-white">{item.author}</strong></span>
        </div>

        <span>•</span>

        <div>
          <span>{isRTL ? 'تاريخ النشر:' : 'Published:'} {new Date(item.published_at || item.created_at).toLocaleDateString(isRTL ? 'ar-EG' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>

        {item.reading_time_minutes > 0 && (
          <>
            <span>•</span>
            <div>
              <span>~{item.reading_time_minutes} {isRTL ? 'دقيقة قراءة' : 'min read'}</span>
            </div>
          </>
        )}
      </div>

      <!-- بيانات الوعاء والنشر والـ DOI -->
      {(item.journal_or_publisher || item.doi || item.volume) && (
        <div class="mt-4 p-3 rounded-lg bg-[#FAF7F0] dark:bg-[#1A2433] border border-[#E2DCD0] dark:border-[#2B384E] text-xs text-[#5A6578] dark:text-gray-300 flex flex-wrap items-center gap-x-6 gap-y-2">
          {item.journal_or_publisher && (
            <div>
              <span class="font-bold text-[#143D33] dark:text-[#B8924A]">{isRTL ? 'جهة النشر / الدورية:' : 'Journal / Publisher:'}</span>{' '}
              <span>{item.journal_or_publisher}</span>
            </div>
          )}
          {item.volume && (
            <div>
              <span class="font-bold text-[#143D33] dark:text-[#B8924A]">{isRTL ? 'المجلد:' : 'Volume:'}</span>{' '}
              <span>{item.volume} {item.issue ? `(${isRTL ? 'العدد' : 'Issue'} ${item.issue})` : ''}</span>
            </div>
          )}
          {item.pages_range && (
            <div>
              <span class="font-bold text-[#143D33] dark:text-[#B8924A]">{isRTL ? 'الصفحات:' : 'Pages:'}</span>{' '}
              <span dir="ltr">{item.pages_range}</span>
            </div>
          )}
          {item.doi && (
            <div dir="ltr" class="text-left font-mono text-[11px]">
              <span class="font-bold text-[#1B365D] dark:text-[#93C5FD]">DOI:</span>{' '}
              <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noopener noreferrer" class="hover:underline text-[#1B365D] dark:text-blue-400">
                {item.doi}
              </a>
            </div>
          )}
        </div>
      )}
    </header>

    <!-- ملخص البحث (Abstract) -->
    {(item.abstract || item.excerpt) && (
      <div class="mb-8 p-5 sm:p-6 bg-[#FAF7F0] dark:bg-[#151D28] rounded-2xl border-r-4 rtl:border-r-4 ltr:border-l-4 border-[#143D33] border-y border-l rtl:border-l-[#E2DCD0] ltr:border-r-[#E2DCD0] dark:border-y-[#2B384E]">
        <h2 class="text-sm font-bold text-[#143D33] dark:text-[#B8924A] uppercase tracking-wider mb-2 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>{isRTL ? 'خلاصة البحث (Abstract)' : 'Abstract'}</span>
        </h2>
        <p class="text-sm leading-relaxed text-[#151C24] dark:text-[#E5E9F0] text-justify font-naskh">
          {item.abstract || item.excerpt}
        </p>

        {/* الكلمات المفتاحية */}
        {item.tags && item.tags.length > 0 && (
          <div class="mt-4 pt-3 border-t border-[#E2DCD0]/60 dark:border-[#2B384E] flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-[#5A6578] dark:text-gray-400">{isRTL ? 'الكلمات المفتاحية:' : 'Keywords:'}</span>
            {item.tags.map(tag => (
              <span class="px-2.5 py-0.5 rounded text-xs bg-white dark:bg-[#1A2433] text-[#1B365D] dark:text-[#93C5FD] border border-[#E2DCD0] dark:border-[#2B384E]">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- متن البحث والأقسام الرئيسية -->
    <article class="bg-white dark:bg-[#1A2433] rounded-2xl p-6 sm:p-10 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
      <div class="academic-reader-content" set:html={item.content} />
    </article>

    <!-- صندوق التوثيق والاقتباس الأكاديمي التفاعلي (Interactive Citation Box) -->
    <section class="mt-10 bg-white dark:bg-[#1A2433] rounded-2xl p-6 sm:p-8 border border-[#B8924A]/40 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#E2DCD0] dark:border-[#2B384E]">
        <div>
          <h3 class="font-amiri font-bold text-lg text-[#143D33] dark:text-[#E5E9F0] flex items-center gap-2">
            <svg class="w-5 h-5 text-[#B8924A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v20c0 4.418 7.163 8 16 8 1.38 0 2.721-.087 4-.252V22c-1.279.165-2.62.252-4 .252-8.837 0-16-3.582-16-8z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
            </svg>
            <span>{isRTL ? 'توثيق واقتباس هذه الدراسة (Citation)' : 'Cite this Research'}</span>
          </h3>
          <p class="text-xs text-[#5A6578] dark:text-gray-400 mt-1">
            {isRTL ? 'انسخ التوثيق العلمي بالصيغة المعتمدة المناسبة لرسالتك أو بحثك الأكاديمي' : 'Copy standard academic bibliographic citation for your bibliography'}
          </p>
        </div>

        <!-- أزرار اختيار صيغة التوثيق -->
        <div class="flex items-center gap-1.5 bg-[#FAF7F0] dark:bg-[#151D28] p-1 rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] text-xs font-bold">
          <button type="button" class="citation-tab px-3 py-1.5 rounded-lg transition-all bg-[#143D33] text-white shadow" data-format="apa">
            APA 7th
          </button>
          <button type="button" class="citation-tab px-3 py-1.5 rounded-lg transition-all text-[#5A6578] hover:text-[#143D33]" data-format="mla">
            MLA 9th
          </button>
          <button type="button" class="citation-tab px-3 py-1.5 rounded-lg transition-all text-[#5A6578] hover:text-[#143D33]" data-format="chicago">
            Chicago
          </button>
        </div>
      </div>

      <!-- مربع نص الاقتباس والنسخ -->
      <div class="mt-4 relative">
        <div
          id="citation-display"
          class="p-4 bg-[#FAF7F0] dark:bg-[#151D28] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] text-xs sm:text-sm font-sans leading-relaxed text-[#151C24] dark:text-[#E5E9F0]"
          dir={item.language === 'en' ? 'ltr' : 'auto'}
        >
          {citations.apa}
        </div>

        <div class="mt-3 flex items-center justify-between text-xs">
          <span id="copy-status" class="text-green-700 font-bold hidden flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{isRTL ? 'تم نسخ التوثيق بنجاح إلى الحافظة!' : 'Citation copied to clipboard!'}</span>
          </span>

          <button
            type="button"
            id="copy-citation-btn"
            class="px-4 py-2 bg-[#B8924A] hover:bg-[#D4B06A] text-[#143D33] font-bold rounded-lg transition-colors flex items-center gap-1.5 ml-auto"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
            </svg>
            <span>{isRTL ? 'نسخ التوثيق' : 'Copy Citation'}</span>
          </button>
        </div>
      </div>
    </section>

    <!-- قائمة المراجع والمصادر العلمية (References & Bibliography) -->
    {item.references && item.references.length > 0 && (
      <section class="mt-10 bg-white dark:bg-[#1A2433] rounded-2xl p-6 sm:p-8 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
        <h3 class="font-amiri font-bold text-xl text-[#143D33] dark:text-[#E5E9F0] mb-4 pb-2 border-b border-[#E2DCD0] dark:border-[#2B384E] flex items-center gap-2">
          <svg class="w-5 h-5 text-[#B8924A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span>{isRTL ? 'المصادر والمراجع العلمية' : 'References & Bibliography'}</span>
        </h3>

        <ol class="space-y-3 text-xs sm:text-sm text-[#151C24] dark:text-[#E5E9F0] list-decimal list-inside">
          {item.references.map((ref) => {
            const isEnglishRef = ref.language === 'en' || /^[A-Za-z]/.test(ref.text);
            return (
              <li
                class={`p-2 rounded hover:bg-[#FAF7F0] dark:hover:bg-[#151D28] transition-colors leading-relaxed ${
                  isEnglishRef ? 'text-left font-sans' : 'text-right font-naskh'
                }`}
                dir={isEnglishRef ? 'ltr' : 'rtl'}
              >
                <span>{ref.text}</span>
                {ref.link && (
                  <a
                    href={ref.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#1B365D] dark:text-blue-400 hover:underline inline-block mr-1 ml-1 text-xs"
                    dir="ltr"
                  >
                    [رابط المرجع]
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    )}

    <!-- أزرار الإجراءات والطباعة والتحميل -->
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 text-xs text-[#5A6578] pt-6 border-t border-[#E2DCD0] dark:border-[#2B384E]">
      <div class="flex items-center gap-3">
        <button
          onclick="window.print()"
          class="px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 rounded-lg text-gray-800 dark:text-gray-200 font-semibold transition-colors flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
          </svg>
          <span>{isRTL ? 'طباعة البحث' : 'Print Paper'}</span>
        </button>

        {item.file_url && item.allow_download && (
          <a
            href={item.file_url}
            download
            class="px-4 py-2 bg-[#143D33] hover:bg-[#1B5245] text-white rounded-lg font-semibold transition-colors flex items-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>{isRTL ? 'تحميل نسخة PDF' : 'Download PDF'}</span>
          </a>
        )}
      </div>

      <a
        href={lang === 'en' ? '/research?lang=en' : '/research'}
        class="font-bold text-[#1B365D] dark:text-[#93C5FD] hover:underline"
      >
        {isRTL ? '← العودة إلى قائمة البحوث والدراسات' : '← Back to Research and Studies'}
      </a>
    </div>

  </div>
</Layout>

<script is:inline define:vars={{ citations }}>
  const tabs = document.querySelectorAll('.citation-tab');
  const display = document.getElementById('citation-display');
  const copyBtn = document.getElementById('copy-citation-btn');
  const copyStatus = document.getElementById('copy-status');

  let activeFormat = 'apa';

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('bg-[#143D33]', 'text-white', 'shadow');
        t.classList.add('text-[#5A6578]');
      });
      tab.classList.add('bg-[#143D33]', 'text-white', 'shadow');
      tab.classList.remove('text-[#5A6578]');

      activeFormat = tab.dataset.format || 'apa';
      if (display && citations[activeFormat]) {
        display.textContent = citations[activeFormat];
      }
    });
  });

  if (copyBtn && display) {
    copyBtn.addEventListener('click', async () => {
      const textToCopy = display.textContent || '';
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (copyStatus) {
          copyStatus.classList.remove('hidden');
          setTimeout(() => {
            copyStatus.classList.add('hidden');
          }, 3000);
        }
      } catch (e) {
        // Fallback for older browsers
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        if (copyStatus) {
          copyStatus.classList.remove('hidden');
          setTimeout(() => {
            copyStatus.classList.add('hidden');
          }, 3000);
        }
      }
    });
  }
</script>
