---
import Layout from '../../layouts/Layout.astro';
import { getItems } from '../../lib/db';

const research = await getItems({ type: 'research' });
---

<Layout title="البحوث والدراسات الأكاديمية">
  <div class="bg-[#1B365D] text-[#F7F3E9] py-12 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">الدراسات التخصصية المحكمة</span>
        <h1 class="text-3xl sm:text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">البحوث والدراسات الأكاديمية</h1>
        <p class="text-sm text-[#F7F3E9]/80 mt-2 leading-relaxed">
          أوراق بحثية ومشاريع استقصائية ترتكز على مناهج التحقيق العلمي، مع هوامش وتوثيق متكامل.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    {research.map((res) => (
      <article class="p-6 bg-white dark:bg-[#1A2433] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-center gap-2 text-xs text-[#B8924A] font-semibold mb-2">
          <span>المؤلف: {res.author}</span>
          <span>•</span>
          <span>دراسة محكمة</span>
        </div>
        <h2 class="text-2xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] hover:text-[#1B365D] transition-colors">
          <a href={`/research/${res.slug}`}>{res.title}</a>
        </h2>
        <p class="text-sm text-[#5A6578] dark:text-gray-300 mt-3 leading-relaxed">
          {res.excerpt}
        </p>
        <div class="mt-5 pt-3 border-t border-[#E2DCD0]/60 flex items-center justify-between">
          <div class="flex gap-2">
            {res.tags.map(t => (
              <span class="px-2 py-0.5 text-xs bg-[#FAF7F0] text-[#1B365D] rounded">#{t}</span>
            ))}
          </div>
          <a href={`/research/${res.slug}`} class="text-xs font-bold text-[#1B365D] hover:underline">
            قراءة البحث كاملاً ←
          </a>
        </div>
      </article>
    ))}
  </div>
</Layout>
