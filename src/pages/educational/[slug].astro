---
import Layout from '../../layouts/Layout.astro';
import { getItemBySlug } from '../../lib/db';

const { slug } = Astro.params;
const item = await getItemBySlug(slug as string, 'ar');

if (!item || item.type !== 'educational') {
  return Astro.redirect('/educational');
}
---

<Layout title={item.title} description={item.excerpt || item.title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="text-xs text-[#5A6578] mb-6 flex items-center gap-2">
      <a href="/" class="hover:underline">الرئيسية</a>
      <span>/</span>
      <a href="/educational" class="hover:underline">المواد التعليمية</a>
      <span>/</span>
      <span class="text-[#143D33] font-semibold">{item.title}</span>
    </nav>

    <header class="mb-8 pb-4 border-b border-[#E2DCD0]">
      <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">حقيبة ومادة تعليمية</span>
      <h1 class="text-3xl sm:text-4xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] mt-2 leading-tight">
        {item.title}
      </h1>
      <p class="text-xs text-[#5A6578] mt-2">إعداد: {item.author}</p>
    </header>

    <div class="bg-white dark:bg-[#1A2433] rounded-2xl p-6 sm:p-10 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
      <div class="academic-reader-content" set:html={item.content} />
    </div>

    <div class="mt-8 flex justify-between text-xs text-[#5A6578]">
      <a href="/educational" class="font-bold text-[#143D33] hover:underline">← العودة إلى المواد التعليمية</a>
    </div>
  </div>
</Layout>
