---
import Layout from '../layouts/Layout.astro';
import { getItems } from '../lib/db';
import { useTranslations, type Language } from '../lib/i18n';

const lang = (Astro.url.searchParams.get('lang') as Language) || 'ar';
const t = useTranslations(lang);
const books = await getItems({ type: 'book', language: lang });

function buildUrl(base: string) {
  if (lang === 'en') {
    return base.includes('?') ? `${base}&lang=en` : `${base}?lang=en`;
  }
  return base;
}
---

<Layout title={lang === 'ar' ? 'عن المؤلف والباحث | محمد رمضان' : 'About the Author | Mohamed Ramadan'} lang={lang}>
  <div class="bg-[#143D33] text-[#F7F3E9] py-14 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">{t.about}</span>
        <h1 class="text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">
          {lang === 'ar' ? 'عن المؤلف: محمد رمضان' : 'About the Author: Mohamed Ramadan'}
        </h1>
        <p class="text-base text-[#F7F3E9]/80 mt-2 leading-relaxed font-ruqaa text-xl">
          {lang === 'ar' 
            ? 'باحث، مؤلف، ومعلم يعنى بالدراسات التراثية والفكرية والإنسانية'
            : 'Scholar, author, and educator dedicated to Islamic heritage and contemporary humanistic studies.'}
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      
      <!-- العمود الجانبي -->
      <div class="md:col-span-4 space-y-6">
        <div class="bg-white dark:bg-[#1A2433] rounded-2xl p-4 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
          <div class="aspect-[4/5] rounded-xl overflow-hidden bg-gray-200">
            <img
              src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&q=80&w=800"
              alt={t.authorCardTitle}
              class="w-full h-full object-cover"
            />
          </div>
          <div class="mt-4 text-center">
            <h2 class="font-amiri font-bold text-xl text-[#143D33] dark:text-[#E5E9F0]">{t.authorCardTitle}</h2>
            <p class="text-xs text-[#B8924A] font-semibold mt-0.5">{t.authorCardRole}</p>
          </div>
        </div>

        <div class="bg-white dark:bg-[#1A2433] rounded-2xl p-6 border border-[#E2DCD0] dark:border-[#2B384E] text-xs space-y-3">
          <h3 class="font-amiri font-bold text-base text-[#143D33] dark:text-[#E5E9F0] border-b border-[#E2DCD0] pb-2">
            {lang === 'ar' ? 'وسائل التواصل الأكاديمي' : 'Academic Communication'}
          </h3>
          <p><strong class="text-[#5A6578]">Email:</strong> info@mohamed-ramadan.com</p>
          <p><strong class="text-[#5A6578]">{lang === 'ar' ? 'التخصص:' : 'Field:'}</strong> {lang === 'ar' ? 'الفكر الإسلامي والدراسات التراثية' : 'Islamic Thought & Heritage Studies'}</p>
          <a
            href={buildUrl('/contact')}
            class="block text-center w-full py-2 bg-[#143D33] text-white font-bold rounded-lg hover:bg-[#1F5A4B] transition-colors mt-2"
          >
            {t.contact}
          </a>
        </div>
      </div>

      <!-- العمود الرئيسي -->
      <div class="md:col-span-8 space-y-8">
        <section class="bg-white dark:bg-[#1A2433] rounded-2xl p-8 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
          <h3 class="font-amiri font-bold text-2xl text-[#143D33] dark:text-[#E5E9F0] mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#B8924A]"></span>
            {lang === 'ar' ? 'الرؤية والمسيرة المعرفية' : 'Scholarly Vision & Trajectory'}
          </h3>
          <p class="text-sm leading-relaxed text-[#151C24] dark:text-[#E5E9F0]">
            {lang === 'ar'
              ? 'يسعى الأستاذ والباحث محمد رمضان من خلال كتاباته وأبحاثه إلى بناء جسر منهجي متين بين علوم التراث العربي والإسلامي وأسئلة الفكر الحديث، مع التركيز على التحقيق الرصين، وإتاحة المعرفة الموثوقة لعموم طلاب العلم والباحثين عبر المنصات الرقمية المعاصرة.'
              : 'Scholar and educator Mohamed Ramadan aims through his monographs and research papers to construct a rigorous methodological bridge between classical Arab-Islamic heritage and contemporary intellectual inquiries, emphasizing disciplined critical editing and open access to scholarly resources.'}
          </p>
        </section>

        <section class="bg-white dark:bg-[#1A2433] rounded-2xl p-8 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
          <h3 class="font-amiri font-bold text-2xl text-[#143D33] dark:text-[#E5E9F0] mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#1B365D]"></span>
            {lang === 'ar' ? 'حقول الاهتمام العلمي' : 'Fields of Research & Interest'}
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-[#151C24] dark:text-[#E5E9F0]">
            <li class="p-3 bg-[#FAF7F0] dark:bg-[#151D28] rounded-lg border border-[#E2DCD0]">
              ✦ {lang === 'ar' ? 'مناهج البحث وتحقيق المخطوطات' : 'Manuscript Codicology & Critical Editing'}
            </li>
            <li class="p-3 bg-[#FAF7F0] dark:bg-[#151D28] rounded-lg border border-[#E2DCD0]">
              ✦ {lang === 'ar' ? 'قضايا الفكر والنهضة المعاصرة' : 'Contemporary Islamic Thought & Renewal'}
            </li>
            <li class="p-3 bg-[#FAF7F0] dark:bg-[#151D28] rounded-lg border border-[#E2DCD0]">
              ✦ {lang === 'ar' ? 'الأدب العربي والجماليات الحضارية' : 'Classical Arabic Literature & Aesthetics'}
            </li>
            <li class="p-3 bg-[#FAF7F0] dark:bg-[#151D28] rounded-lg border border-[#E2DCD0]">
              ✦ {lang === 'ar' ? 'تطوير المناهج والوسائط التعليمية' : 'Educational Curricula & Digital Pedagogy'}
            </li>
          </ul>
        </section>

        <section class="bg-white dark:bg-[#1A2433] rounded-2xl p-8 border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm">
          <h3 class="font-amiri font-bold text-2xl text-[#143D33] dark:text-[#E5E9F0] mb-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#143D33]"></span>
            {lang === 'ar' ? 'المؤلفات المنشورة بالمكتبة' : 'Publications in this Library'}
          </h3>
          <div class="space-y-3">
            {books.map((b) => (
              <a href={buildUrl(`/books/${b.slug}`)} class="block p-4 bg-[#FAF7F0] dark:bg-[#151D28] rounded-xl border border-[#E2DCD0] hover:border-[#143D33] transition-colors">
                <h4 class="font-amiri font-bold text-base text-[#143D33] dark:text-[#B8924A]">{b.title}</h4>
                <p class="text-xs text-[#5A6578] mt-1 line-clamp-1">{b.excerpt}</p>
              </a>
            ))}
          </div>
        </section>
      </div>

    </div>
  </div>
</Layout>
