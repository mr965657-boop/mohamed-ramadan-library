---
import '../styles/global.css';
import { verifyAdminSession } from '../lib/auth';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// حماية خادمية لكافة صفحات لوحة الإدارة
const auth = await verifyAdminSession(Astro.request, 'reader');
if (!auth.authorized) {
  return Astro.redirect('/admin/login');
}

const navItems = [
  { href: '/admin', label: 'لوحة المعلومات', icon: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z' },
  { href: '/admin/items', label: 'إدارة المحتوى', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { href: '/admin/items/new', label: 'إضافة عمل جديد', icon: 'M12 4v16m8-8H4' },
  { href: '/admin/categories', label: 'التصنيفات والأقسام', icon: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z' },
  { href: '/admin/subscribers', label: 'المشتركون في النشرة', icon: 'M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207' },
  { href: '/admin/messages', label: 'صندوق الرسائل', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { href: '/admin/settings', label: 'الصلاحيات والإعدادات', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | لوحة تحكم المكتبة</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#F4F1EA] text-[#151C24] min-h-screen flex antialiased">
    
    <!-- القائمة الجانبية (Sidebar) -->
    <aside class="w-64 bg-[#143D33] text-[#F7F3E9] flex flex-col justify-between shrink-0 border-l border-[#B8924A]/40">
      <div>
        <!-- الهيدر الجانبي -->
        <div class="p-6 border-b border-white/10 flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-[#B8924A] text-[#143D33] font-amiri font-bold text-2xl flex items-center justify-center">
            م
          </div>
          <div>
            <span class="block font-amiri font-bold text-lg text-white">لوحة الإدارة</span>
            <span class="block text-[10px] text-[#B8924A] font-sans tracking-wider">ADMIN CONTROL PANEL</span>
          </div>
        </div>

        <!-- الروابط -->
        <nav class="p-4 space-y-1 text-sm">
          {navItems.map((item) => {
            const active = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg font-medium transition-all ${
                  active
                    ? 'bg-[#B8924A] text-[#143D33] font-bold shadow'
                    : 'text-white/80 hover:bg-white/10 hover:text-white'
                }`}
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
                </svg>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>
      </div>

      <!-- تذييل الشريط الجانبي: معلومات المدير وتسجيل الخروج -->
      <div class="p-4 border-t border-white/10 space-y-3">
        <div class="flex items-center gap-3 px-2 text-xs">
          <div class="w-8 h-8 rounded-full bg-[#B8924A]/30 text-[#B8924A] flex items-center justify-center font-bold">
            مدير
          </div>
          <div class="overflow-hidden">
            <p class="font-bold text-white truncate">مدير النظام ({auth.role})</p>
            <p class="text-[10px] text-white/60">جلسة آمنة نشطة</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/"
            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-2 text-xs font-bold rounded-lg border border-white/20 hover:bg-white/10 text-white transition-colors"
          >
            <span>الموقع العام</span>
          </a>

          <button
            type="button"
            id="admin-logout-btn"
            class="py-2 px-3 text-xs font-bold rounded-lg bg-red-900/40 hover:bg-red-800 text-red-200 border border-red-500/30 transition-colors"
            title="تسجيل الخروج"
          >
            خروج
          </button>
        </div>
      </div>
    </aside>

    <!-- المحتوى الرئيسي للوحة التحكم -->
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <header class="h-16 bg-white border-b border-[#E2DCD0] px-8 flex items-center justify-between">
        <h1 class="text-xl font-amiri font-bold text-[#143D33]">{title}</h1>
        <div class="flex items-center gap-3 text-xs">
          <span class="px-2.5 py-1 rounded bg-green-50 text-green-700 font-bold border border-green-200 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse"></span>
            <span>النظام متصل ونشط</span>
          </span>
        </div>
      </header>

      <main class="p-8">
        <slot />
      </main>
    </div>

    <script is:inline>
      const logoutBtn = document.getElementById('admin-logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          if (!confirm('هل تريد تسجيل الخروج من لوحة التحكم؟')) return;
          try {
            await fetch('/api/admin/logout', { method: 'POST' });
            window.location.href = '/admin/login';
          } catch (e) {
            window.location.href = '/admin/login';
          }
        });
      }
    </script>

  </body>
</html>
