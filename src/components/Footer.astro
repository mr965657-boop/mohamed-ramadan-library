---
import { useTranslations, type Language } from '../lib/i18n';

interface Props {
  lang?: Language;
}

const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

function buildUrl(base: string) {
  if (lang === 'en') {
    return base.includes('?') ? `${base}&lang=en` : `${base}?lang=en`;
  }
  return base;
}
---

<footer class="mt-20 bg-[#143D33] text-[#F7F3E9] border-t-4 border-[#B8924A] relative overflow-hidden">
  <!-- زخرفة هندسية هادئة في الخلفية -->
  <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#B8924A_1px,transparent_1px)] [background-size:16px_16px]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- تعريف المكتبة -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded bg-[#B8924A] text-[#143D33] font-amiri font-bold text-2xl flex items-center justify-center">
            {lang === 'ar' ? 'م' : 'M'}
          </div>
          <span class="font-amiri font-bold text-2xl text-[#F7F3E9]">{t.brandName}</span>
        </div>
        <p class="text-sm text-[#F7F3E9]/80 leading-relaxed max-w-md">
          {t.footerDesc}
        </p>
        <div class="pt-2 text-xs text-[#B8924A] flex flex-wrap items-center gap-4">
          <span>{t.footerFeature1}</span>
          <span>{t.footerFeature2}</span>
          <span>{t.footerFeature3}</span>
        </div>
      </div>

      <!-- روابط الأقسام -->
      <div>
        <h3 class="font-amiri font-bold text-lg text-[#B8924A] mb-4">{t.quickLinksTitle}</h3>
        <ul class="space-y-2 text-sm text-[#F7F3E9]/85">
          <li><a href={buildUrl('/books')} class="hover:text-[#B8924A] transition-colors">{t.books}</a></li>
          <li><a href={buildUrl('/research')} class="hover:text-[#B8924A] transition-colors">{t.research}</a></li>
          <li><a href={buildUrl('/articles')} class="hover:text-[#B8924A] transition-colors">{t.articles}</a></li>
          <li><a href={buildUrl('/lectures')} class="hover:text-[#B8924A] transition-colors">{t.lectures}</a></li>
          <li><a href={buildUrl('/literature')} class="hover:text-[#B8924A] transition-colors">{t.literature}</a></li>
          <li><a href={buildUrl('/educational')} class="hover:text-[#B8924A] transition-colors">{t.educational}</a></li>
        </ul>
      </div>

      <!-- الاشتراك في النشرة البريدية -->
      <div>
        <h3 class="font-amiri font-bold text-lg text-[#B8924A] mb-4">{t.newsletterTitle}</h3>
        <p class="text-xs text-[#F7F3E9]/75 mb-3 leading-relaxed">
          {t.newsletterDesc}
        </p>
        <form id="newsletter-form" class="space-y-2">
          <input
            type="email"
            id="newsletter-email"
            required
            placeholder={t.newsletterPlaceholder}
            class="w-full px-3.5 py-2 text-sm bg-white/10 border border-white/20 rounded text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-[#B8924A]"
          />
          <button
            type="submit"
            class="w-full py-2 px-4 bg-[#B8924A] hover:bg-[#D4B06A] text-[#143D33] font-semibold text-xs rounded transition-colors uppercase tracking-wider"
          >
            {t.newsletterBtn}
          </button>
          <div id="newsletter-msg" class="hidden text-xs text-[#B8924A] mt-1 text-center font-medium"></div>
        </form>
      </div>

    </div>

    <!-- الشريط السفلي -->
    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-[#F7F3E9]/60 gap-4">
      <div>
        {t.copyright.replace('{year}', year.toString())}
      </div>
      <div class="flex items-center gap-6">
        <a href={buildUrl('/about')} class="hover:text-[#B8924A]">{t.about}</a>
        <a href={buildUrl('/contact')} class="hover:text-[#B8924A]">{t.contact}</a>
        <a href="/admin" class="hover:text-[#B8924A]">{t.admin}</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ currentLang: lang }}>
  const form = document.getElementById('newsletter-form');
  const emailInput = document.getElementById('newsletter-email');
  const msg = document.getElementById('newsletter-msg');
  const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

  if (form && msg && emailInput && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email) return;

      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = currentLang === 'ar' ? 'جارٍ التسجيل...' : 'Subscribing...';
      msg.className = 'hidden';

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, language: currentLang }),
        });
        const data = await res.json();

        if (res.ok && data.success) {
          msg.textContent = data.message;
          msg.className = 'text-xs text-[#B8924A] mt-2 text-center font-bold block';
          form.reset();
        } else {
          msg.textContent = data.error || (currentLang === 'ar' ? 'حدث خطأ، يرجى المحاولة لاحقاً.' : 'An error occurred.');
          msg.className = 'text-xs text-red-300 mt-2 text-center font-medium block';
        }
      } catch (err) {
        msg.textContent = currentLang === 'ar' ? 'تعذر الاتصال بالخادم.' : 'Server connection failed.';
        msg.className = 'text-xs text-red-300 mt-2 text-center font-medium block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }
</script>
