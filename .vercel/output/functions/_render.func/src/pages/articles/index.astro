---
import Layout from '../../layouts/Layout.astro';
import { getItems } from '../../lib/db';

const articles = await getItems({ type: 'article' });
---

<Layout title="المقالات الفكرية والثقافية">
  <div class="bg-[#143D33] text-[#F7F3E9] py-12 border-b-2 border-[#B8924A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-[#B8924A] uppercase tracking-wider">كتابات ورؤى</span>
        <h1 class="text-3xl sm:text-4xl font-amiri font-bold mt-1 text-[#F7F3E9]">المقالات الفكرية والثقافية</h1>
        <p class="text-sm text-[#F7F3E9]/80 mt-2 leading-relaxed">
          مقالات دورية، تأملات نقدية، وقراءات في الفكر واللغة والمجتمع.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {articles.map((art) => (
        <article class="p-6 bg-white dark:bg-[#1A2433] rounded-xl border border-[#E2DCD0] dark:border-[#2B384E] shadow-sm hover:border-[#B8924A] transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs text-[#5A6578] mb-2">
              <span class="text-[#B8924A] font-bold">مقال فكري</span>
              <span>~{art.reading_time_minutes} دقائق قراءة</span>
            </div>
            <h2 class="text-2xl font-amiri font-bold text-[#143D33] dark:text-[#E5E9F0] hover:text-[#B8924A] transition-colors leading-snug">
              <a href={`/articles/${art.slug}`}>{art.title}</a>
            </h2>
            <p class="text-xs text-[#5A6578] dark:text-gray-300 mt-3 line-clamp-3 leading-relaxed">
              {art.excerpt}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#E2DCD0]/60 flex items-center justify-between text-xs">
            <span class="text-[#5A6578]">{art.author}</span>
            <a href={`/articles/${art.slug}`} class="font-bold text-[#143D33] dark:text-[#B8924A] hover:underline">
              متابعة القراءة ←
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
